  <div class="notepad-header">
    <div class="notepad-header-left">
      <span class="notepad-icon">📝</span>
      <span class="notepad-title">Notepad</span>
    </div>
    <span class="np-saved-flash" id="np-saved-flash">Saved ✓</span>
    <button class="notepad-close-mobile" id="notepad-close-mobile" onclick="NP.closeMobile()" title="Close">✕</button>
  </div>

  <!-- Tab strip -->
  <div class="notepad-tabs">
    <button class="notepad-tab active" id="np-tab-notes" onclick="NP.switchPane('notes',this)">Notes</button>
    <button class="notepad-tab" id="np-tab-tasks" onclick="NP.switchPane('tasks',this)">Checklist</button>
    <button class="notepad-tab" id="np-tab-quotes" onclick="NP.switchPane('quotes',this)">Quotes</button>
  </div>
  <div class="notepad-tab-sep"></div>

  <!-- ── Pane: Notes (freeform textarea) ── -->
  <div class="notepad-pane active" id="np-pane-notes">
    <textarea class="notepad-textarea" id="np-textarea"
      placeholder="Write anything — plans, ideas, reflections, focus intentions…"
      oninput="NP.onType()"
      spellcheck="false"></textarea>
    <div class="notepad-footer">
      <span class="np-char-count" id="np-char-count">0 chars</span>
      <div class="np-footer-actions">
        <span class="np-saved-flash" id="np-note-saved" style="margin-right:4px">Saved ✓</span>
        <button class="np-action-btn" onclick="NP.copyNote()" title="Copy all text">Copy</button>
        <button class="np-action-btn danger" onclick="NP.clearNote()" title="Clear note">Clear</button>
      </div>
    </div>
  </div>

  <!-- ── Pane: Checklist ── -->
  <div class="notepad-pane" id="np-pane-tasks">
    <div class="notepad-checklist" id="np-checklist"></div>
    <div class="notepad-check-add">
      <input type="text" class="np-add-input" id="np-check-input"
        placeholder="Add item…" maxlength="120"
        onkeydown="if(event.key==='Enter')NP.addCheckItem()"/>
      <button class="np-add-btn" onclick="NP.addCheckItem()">+ Add</button>
    </div>
    <div class="notepad-footer" style="padding:6px 14px">
      <span class="np-char-count" id="np-check-count">0 items</span>
      <div class="np-footer-actions">
        <button class="np-action-btn danger" onclick="NP.clearChecked()">Clear Done</button>
      </div>
    </div>
  </div>

  <!-- ── Pane: Quotes ── -->
  <div class="notepad-pane" id="np-pane-quotes">
    <div class="notepad-quotes" id="np-quotes-list"></div>
    <div class="notepad-quote-add">
      <textarea class="np-quote-textarea" id="np-quote-text"
        placeholder="&#8220;Write your favourite quote or mantra here…&#8221;"
        rows="2" maxlength="300"
        onkeydown="if(event.key==='Enter'&&(event.ctrlKey||event.metaKey))NP.addQuote()"></textarea>
