  // ───── 14. KEYBOARD: ENHANCED SHORTCUTS ──────────────────────
  // R = reset active timer, N = new task (when on tasks tab)
  document.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    const active = document.querySelector('.panel.active')?.id;
    if (e.code === 'KeyR' && !e.metaKey && !e.ctrlKey) {
      if (active === 'panel-sw' && !document.getElementById('sw-btn-reset').disabled) { e.preventDefault(); window.swReset && swReset(); }
      else if (active === 'panel-tm' && !document.getElementById('tm-btn-reset').disabled) { e.preventDefault(); window.tmReset && tmReset(); }
      else if (active === 'panel-pm' && !document.getElementById('pomo-btn-reset').disabled) { e.preventDefault(); window.pomoReset && pomoReset(); }
    }
    if (e.code === 'KeyN' && active === 'panel-tk' && !e.metaKey && !e.ctrlKey) {
      e.preventDefault();
      const inp = document.getElementById('task-input');
      inp && inp.focus();
    }
    // 1-6 for tab switch
    if (/^Digit[1-5]$/.test(e.code) && !e.metaKey && !e.ctrlKey && !e.altKey) {
      const idx = parseInt(e.code.replace('Digit',''),10) - 1;
      const tabs = ['sw','tm','pm','tk','st'];
      if (tabs[idx]) { e.preventDefault(); window.switchTab && switchTab(tabs[idx]); Haptic.tap(); }
    }
  });

  // ───── 16. EXPORT CSV OPTION (bonus) ─────────────────────────
  // Adds CSV export alongside existing JSON export if button present
  // Attach to any future "Export CSV" invocations
  window.exportCSV = function() {
    try {
      const sessions = (window.Store && Store.sessions.load) ? Store.sessions.load() : [];
      const rows = [['date','type','duration_ms','duration_readable','taskName','goalId','hour']];
      const toReadable = (ms) => {
        const s=Math.floor(ms/1000),h=Math.floor(s/3600),m=Math.floor((s%3600)/60);
        return (h?h+'h ':'')+(m?m+'m':'')+(!h&&!m?(s+'s'):'');
      };
      sessions.forEach(s => rows.push([s.date,s.type,s.ms,toReadable(s.ms),s.taskName||'',s.goalId||'',s.hour||'']));
      const csv = rows.map(r => r.map(c => `"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n');
      const blob = new Blob([csv], {type:'text/csv;charset=utf-8'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'chronoblast-sessions-' + new Date().toISOString().slice(0,10) + '.csv';
      a.click();
      URL.revokeObjectURL(url);
    } catch(e) { console.error(e); }
  };

  // ───── 17. VISUAL POLISH: ENHANCE EXISTING RING MILESTONES ──
  const ringFill = document.getElementById('ring-fill');
  if (ringFill) {
    new MutationObserver(() => {
      const orig = parseFloat(ringFill.getAttribute('stroke-dasharray') || 515);
      const offset = parseFloat(ringFill.style.strokeDashoffset || 0);
      const pct = Math.max(0, Math.min(100, 100 - (offset / orig) * 100));
      if (pct >= 90) ringFill.setAttribute('data-milestone','90');
      if (pct >= 100) ringFill.setAttribute('data-milestone','100');
      if (pct < 90) ringFill.removeAttribute('data-milestone');
    }).observe(ringFill, { attributes:true, attributeFilter:['style'] });
  }

  // ───── 18. SAFE-MODE AUDIO FALLBACK ──────────────────────────
  // Gracefully handle autoplay-blocked AudioContext
  const safeAudioWarning = () => {
    try {
      if (window.Audio && typeof Audio.ensure === 'function') {
        Audio.ensure();
      }
    } catch(e){}
  };
  safeAudioWarning();

  // ───── 19. THEME TOGGLE ROTATION POLISH ──────────────────────
  const tBtn = document.getElementById('theme-toggle-btn');
  if (tBtn) {
    tBtn.addEventListener('click', () => {
      tBtn.animate(
        [{ transform:'rotate(0) scale(1)' },
         { transform:'rotate(180deg) scale(1.18)' },
         { transform:'rotate(360deg) scale(1)' }],
        { duration: 520, easing:'cubic-bezier(0.34,1.56,0.64,1)' }
      );
      Haptic.press();
    });
  }

  // ───── 20. CONSOLE SIGNATURE ─────────────────────────────────
  try {
    const art = [
      '%c  ChronoBlast  ',
      'background:linear-gradient(90deg,#00bfa6,#00e6c8);color:#06080d;padding:6px 12px;border-radius:6px;font-weight:700;font-size:14px;letter-spacing:0.3em'
    ];
    console.log(...art, '%c\n  Focus · Track · Measure  \n  Premium build — polished execution layer active.', 'color:#00e6c8;font-size:11px');
  } catch(e){}

  // ───── 21. FIRST-TIME ENTRANCE: PANEL STAGGER RE-ENABLE ──────
  // The staggered entrance fires naturally via CSS on first load;
  // re-apply when switching tabs for consistent polish.
  if (window.switchTab) {
    const _origSwitch = window.switchTab;
    window.switchTab = function(id) {
      _origSwitch(id);
      Haptic.tap();
    };
  }

  // ───── 22. INSTALL A LIGHT CREDIT-TOAST AUTO-DISMISS ──────────
  // Tap anywhere outside credit toast to dismiss
  document.addEventListener('click', (e) => {
    const t = document.getElementById('credit-toast');
    if (!t || !t.classList.contains('show')) return;
    if (t.contains(e.target)) return;
    setTimeout(() => { if (window.CreditToast) CreditToast.hide(); }, 250);
  });

  // ───── 23. INTERSECTION OBSERVER FOR LAZY STAT RENDERS ───────
  // Avoid rendering off-screen stats until they enter viewport
  // (optional perf boost for long Stats tab)
  // Skipped: Stats tab is light enough; leaving commented as future hook.

  // ───── 24. HEALTH CHECK ──────────────────────────────────────
  // Surface any uncaught errors as a soft console warning (dev aid)
  window.addEventListener('error', (e) => {
    console.warn('[ChronoBlast] non-fatal:', e.message);
  });

})();

// ══════════════════════════════════════════════════════════════════
// MODULE: GOOGLE CALENDAR SYNC
// Full OAuth 2.0 via Google Identity Services.
// Sessions → Calendar events, synced from the browser — no server.
// ══════════════════════════════════════════════════════════════════
const GCalSync = (() => {
  const CID_KEY      = 'cb_gcal_cid';
  const SYNCED_KEY   = 'cb_gcal_synced';  // Set of ISO date strings already pushed
  const LAST_KEY     = 'cb_gcal_last';    // Timestamp of last successful sync

  let _token       = null;  // Short-lived access token
  let _tokenClient = null;  // GIS tokenClient instance
  let _clientId    = '';    // User-supplied OAuth client ID
  let _synced      = new Set();

  // ── Persistence helpers ──────────────────────────────────────
  const persist = () => {
    try {
      localStorage.setItem(SYNCED_KEY, JSON.stringify([..._synced].slice(-600)));
    } catch(e) {}
  };

  const loadLocal = () => {
    _clientId = localStorage.getItem(CID_KEY) || '';
    try { _synced = new Set(JSON.parse(localStorage.getItem(SYNCED_KEY) || '[]')); } catch { _synced = new Set(); }
  };

  // ── Session → Google Calendar event ─────────────────────────
  const toEvent = (s) => {
    const start = new Date(s.date);
    // Minimum event duration 1 minute so GCal doesn't reject it
    const end   = new Date(start.getTime() + Math.max(s.ms, 60000));
    const icon  = { Stopwatch:'⏱', Timer:'⏳', Pomodoro:'🍅', Task:'✅', Mirror:'🪞' }[s.type] || '⏱';
    const title = s.taskName
      ? `${icon} ${s.taskName}`
      : `${icon} ${s.type} Session`;
    const colorId = s.type === 'Pomodoro' ? '11' : s.type === 'Timer' ? '7' : s.type === 'Task' ? '2' : '1';
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    return {
      summary: title + ' · ChronoBlast',
      description: [
        'Logged by ChronoBlast  ⏱',
        `Type: ${s.type}`,
        `Duration: ${Fmt.dur(s.ms)}`,
        s.taskName ? `Task: ${s.taskName}` : null,
      ].filter(Boolean).join('\n'),
      start: { dateTime: start.toISOString(), timeZone: tz },
      end:   { dateTime: end.toISOString(),   timeZone: tz },
      colorId,
    };
  };

  // ── Log panel ────────────────────────────────────────────────
  const log = (msg, type = 'info') => {
    const panel = document.getElementById('gcal-log');
    if (!panel) return;
    const row = document.createElement('div');
    row.className = 'gcal-log-row ' + type;
    const now = new Date();
    const ts  = Fmt.p2(now.getHours()) + ':' + Fmt.p2(now.getMinutes()) + ':' + Fmt.p2(now.getSeconds());
    const prefix = type === 'ok' ? '✓' : type === 'err' ? '✕' : '·';
    row.innerHTML = `<span class="gcal-log-time">${ts}</span>${prefix} ${msg}`;
    panel.prepend(row);
    // Keep log tidy — max 40 rows
    while (panel.children.length > 40) panel.removeChild(panel.lastChild);
  };

  // ── UI state machine ─────────────────────────────────────────
  const render = () => {
    loadLocal();
    const elSetup     = document.getElementById('gcal-setup-view');
    const elConnect   = document.getElementById('gcal-connect-view');
    const elConnected = document.getElementById('gcal-connected-view');
    const elPill      = document.getElementById('gcal-status-pill');
    if (!elSetup) return;

    if (!_clientId) {
      elSetup.style.display     = '';
      elConnect.style.display   = 'none';
      elConnected.style.display = 'none';
      if (elPill) { elPill.textContent = 'Setup needed'; elPill.style.color = ''; }
    } else if (!_token) {
      elSetup.style.display     = 'none';
      elConnect.style.display   = '';
      elConnected.style.display = 'none';
      if (elPill) { elPill.textContent = 'Not connected'; elPill.style.color = ''; }
    } else {
      elSetup.style.display     = 'none';
      elConnect.style.display   = 'none';
      elConnected.style.display = '';
      if (elPill) { elPill.textContent = '✓ Connected'; elPill.style.color = 'var(--teal)'; }
      _updateStats();
    }
  };

  const _updateStats = () => {
    loadLocal();
    const sessions  = Store.sessions.load();
    const unsynced  = sessions.filter(s => !_synced.has(s.date)).length;
    const totalSynced = _synced.size;
    const lastRaw   = localStorage.getItem(LAST_KEY);
    const lastLabel = lastRaw
      ? new Date(parseInt(lastRaw, 10)).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
      : 'Never';

    const elLabel   = document.getElementById('gcal-account-label');
    const elUnsync  = document.getElementById('gcal-unsynced-count');
    const elTotal   = document.getElementById('gcal-total-synced');
    const elLast    = document.getElementById('gcal-last-sync');
    const elBtn     = document.getElementById('gcal-sync-btn');

    if (elLabel)  elLabel.textContent  = `Google Calendar connected · ${sessions.length} sessions total`;
    if (elUnsync) elUnsync.textContent = unsynced + (unsynced === 1 ? ' session' : ' sessions');
    if (elTotal)  elTotal.textContent  = totalSynced;
    if (elLast)   elLast.textContent   = lastLabel;
    if (elBtn)    elBtn.textContent    = unsynced > 0
      ? `📤 Sync ${unsynced} Session${unsynced !== 1 ? 's' : ''} to Calendar`
      : '✓ All synced';
  };

  // ── GIS tokenClient init ──────────────────────────────────────
  const _initClient = () => {
    if (!window.google?.accounts?.oauth2) {
      log('Google Identity Services not loaded yet — try again in a moment', 'err');
      return false;
    }
    _tokenClient = google.accounts.oauth2.initTokenClient({
      client_id: _clientId,
      scope: 'https://www.googleapis.com/auth/calendar.events',
      callback: (resp) => {
        if (resp.error) {
          log('Auth failed: ' + (resp.error_description || resp.error), 'err');
          return;
        }
        _token = resp.access_token;
        log('Connected to Google Calendar ✓', 'ok');
        render();
      },
    });
    return true;
  };

  // ── Public API ───────────────────────────────────────────────
  return {
    // Called every time Stats tab is opened
    refresh() {
      render();
    },

    saveClientId() {
      const input = document.getElementById('gcal-client-id-input');
      const errEl = document.getElementById('gcal-setup-err');
      const val   = (input?.value || '').trim();

      if (!val) {
        if (errEl) errEl.textContent = '⚠ Please paste your OAuth 2.0 Client ID.';
        return;
      }
      if (!val.endsWith('.apps.googleusercontent.com')) {
        if (errEl) errEl.textContent = '⚠ Valid Client IDs end with .apps.googleusercontent.com';
        return;
      }
      if (errEl) errEl.textContent = '';
      _clientId = val;
      localStorage.setItem(CID_KEY, _clientId);
      render();
    },

    clearClientId() {
      _clientId = '';
      _token    = null;
      _tokenClient = null;
      localStorage.removeItem(CID_KEY);
      render();
    },

    connect() {
      if (!_tokenClient && !_initClient()) return;
      // prompt:'consent' forces account picker on every connect (clean UX)
      _tokenClient.requestAccessToken({ prompt: 'consent' });
    },

    disconnect() {
      if (_token && window.google?.accounts?.oauth2) {
        google.accounts.oauth2.revoke(_token, () => {});
      }
      _token = null;
      log('Disconnected from Google Calendar.', 'info');
      render();
    },

    async syncAll() {
      if (!_token) { render(); return; }
      loadLocal();

      const sessions = Store.sessions.load();
      const toSync   = sessions.filter(s => !_synced.has(s.date));

      const btn = document.getElementById('gcal-sync-btn');
      if (!toSync.length) {
        log('All sessions already synced ✓', 'ok');
        if (btn) btn.textContent = '✓ All synced';
        return;
      }

      if (btn) { btn.disabled = true; btn.textContent = `⏳ Syncing ${toSync.length} session${toSync.length !== 1 ? 's' : ''}…`; }

      let ok = 0, fail = 0;

      for (const s of toSync) {
        try {
          const res = await fetch(
            'https://www.googleapis.com/calendar/v3/calendars/primary/events',
            {
              method: 'POST',
              headers: {
                Authorization: 'Bearer ' + _token,
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(toEvent(s)),
            }
          );

          if (res.ok) {
            _synced.add(s.date);
            ok++;
            const label = s.taskName
              ? s.taskName.slice(0, 28)
              : s.type + ' Session';
            log(`${label} · ${Fmt.dur(s.ms)}`, 'ok');
          } else if (res.status === 401) {
            // Access token expired — need re-auth
            _token = null;
            log('Token expired — please reconnect to continue', 'err');
            render();
            break;
          } else {
            const body = await res.json().catch(() => ({}));
            fail++;
            log(`Failed (${res.status}): ${body?.error?.message || 'unknown error'}`, 'err');
          }
        } catch (e) {
          fail++;
          log('Network error: ' + e.message, 'err');
        }
      }

      persist();
      if (ok) localStorage.setItem(LAST_KEY, String(Date.now()));

      if (btn) { btn.disabled = false; }
      _updateStats();

      if (ok > 0 && fail === 0) log(`Synced ${ok} session${ok !== 1 ? 's' : ''} ✓`, 'ok');
      else if (ok > 0 && fail > 0) log(`Synced ${ok}, failed ${fail}`, 'info');
      else if (ok === 0 && fail > 0) log('Sync failed — check console for details', 'err');
    },
  };
})();

</script>

