.task-pri-pill,.dur-pill,.dur-mode-btn,.launch-mode-btn,.credit-yes,.credit-no,
.tit-btn,.mirror-launch-btn,.pwa-install-btn,.pwa-dismiss-btn,.clear-btn,
.task-color-dot,.task-check,.cal-day,.mr-task-row,.session-item,.lap-item,
.stat-card,.report-tab,.hm-cell{cursor:pointer;}
.task-text-input,.pf-input,.time-field input,.mr-hms-input,.fm-popup-vol-slider{cursor:text;}
.fm-popup-vol-slider{cursor:ew-resize;}

</style>
</head>
<body>
<div class="ambient"></div>
<div class="grid-bg"></div>
<div class="app">

  <!-- Header -->
  <div class="header">
    <button class="theme-toggle" id="theme-toggle-btn" onclick="toggleTheme()" title="Toggle light/dark mode">🌙</button>
    <div class="header-logo">
      <div class="logo-icon">
        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="8" cy="9" r="5.5" stroke="#00e6c8" stroke-width="1.2"/>
          <path d="M8 6v3.5l2 1.2" stroke="#00e6c8" stroke-width="1.2" stroke-linecap="round"/>
          <path d="M6 1.5h4M8 1.5V3.5" stroke="#00e6c8" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
      </div>
      <h1>CHRONOBLAST</h1>
    </div>
    <div class="header-sub">Focus · Track · Measure</div>
  </div>

  <!-- Tabs -->
  <div class="tabs">
    <button class="tab active" onclick="switchTab('sw')"><span class="tab-icon">⏱</span><span class="tab-label">SW</span></button>
    <button class="tab" onclick="switchTab('tm')"><span class="tab-icon">⏳</span><span class="tab-label">Timer</span></button>
    <button class="tab" onclick="switchTab('pm')"><span class="tab-icon">🍅</span><span class="tab-label">Pomo</span></button>
    <button class="tab" onclick="switchTab('tk')"><span class="tab-icon">✅</span><span class="tab-label">Tasks</span></button>
    <button class="tab" onclick="switchTab('st')"><span class="tab-icon">📊</span><span class="tab-label">Stats</span></button>
  </div>

  <!-- ══ STOPWATCH ══ -->
  <div class="panel active" id="panel-sw">
    <div class="card" id="sw-card">
      <div class="display-area">
        <div class="time-label">Elapsed Time</div>
        <div class="time-display" id="sw-display">00:00<span class="ms">.00</span></div>
      </div>
      <div class="sw-progress"><div class="sw-progress-fill" id="sw-progress-fill"></div></div>
      <div class="btn-row">
        <button class="btn btn-primary" id="sw-btn-start" onclick="swToggle()">Start</button>
        <button class="btn" id="sw-btn-lap" onclick="swLap()" disabled>Lap</button>
        <button class="btn btn-danger" id="sw-btn-reset" onclick="swReset()" disabled>Reset</button>
      </div>
    </div>
    <div class="sub-card">
      <div class="section-header">
        <span class="section-title">Lap Times</span>
        <span class="pill" id="lap-count">0 laps</span>
      </div>
      <div class="scroll-list" id="lap-list"><div class="empty-state">No laps recorded</div></div>
    </div>
  </div>

  <!-- ══ TIMER ══ -->
  <div class="panel" id="panel-tm">
    <div class="card" id="tm-card">
      <div class="timer-input-section" id="tm-input-section">
        <div class="timer-input-label">Set Duration</div>
        <div class="timer-input-row">
          <div class="time-field"><label>H</label><input type="number" id="tm-h" min="0" max="23" value="0" oninput="clamp(this,23)"/></div>
          <span class="time-sep">:</span>
          <div class="time-field"><label>M</label><input type="number" id="tm-m" min="0" max="59" value="25" oninput="clamp(this,59)"/></div>
          <span class="time-sep">:</span>
          <div class="time-field"><label>S</label><input type="number" id="tm-s" min="0" max="59" value="0" oninput="clamp(this,59)"/></div>
        </div>
        <div class="presets">
          <button class="preset-btn" onclick="setPreset(2,0,0)">2h</button>
          <button class="preset-btn" onclick="setPreset(1,0,0)">1h</button>
          <button class="preset-btn" onclick="setPreset(0,45,0)">45m</button>
          <button class="preset-btn" onclick="setPreset(0,25,0)">25m</button>
          <button class="preset-btn" onclick="setPreset(0,15,0)">15m</button>
          <button class="preset-btn" onclick="setPreset(0,5,0)">5m</button>
        </div>
      </div>
      <div class="ring-wrap" id="tm-ring-wrap">
        <svg class="ring-svg" width="192" height="192" viewBox="0 0 192 192">
          <defs>
            <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#00bfa6"/>
              <stop offset="100%" stop-color="#00e6c8"/>
            </linearGradient>
          </defs>
          <circle class="ring-bg" cx="96" cy="96" r="82" stroke-width="5"/>
          <circle class="ring-fill" id="ring-fill" cx="96" cy="96" r="82" stroke-width="5"
            stroke-dasharray="515" stroke-dashoffset="0"/>
        </svg>
        <div class="ring-center">
          <div class="time-label">Remaining</div>
          <div class="time-display" id="tm-display" style="font-size:2rem">00:00<span class="ms">.00</span></div>
        </div>
      </div>
      <div class="completion-wrap" id="tm-completion" style="display:none">
        <div class="completion-header">
          <span class="completion-label">Session Complete</span>
          <span class="completion-pct" id="tm-pct">0%</span>
        </div>
        <div class="completion-track"><div class="completion-fill" id="tm-fill"></div></div>
      </div>
      <div class="done-bar" id="done-bar">✦ Time's Up ✦</div>
      <div class="btn-row">
        <button class="btn btn-primary" id="tm-btn-set" onclick="tmSet()">Set</button>
        <button class="btn" id="tm-btn-start" onclick="tmToggle()" disabled>Start</button>
        <button class="btn btn-danger" id="tm-btn-reset" onclick="tmReset()" disabled>Reset</button>
      </div>
    </div>
  </div>

  <!-- ══ POMODORO ══ -->
  <div class="panel" id="panel-pm">
    <div class="sub-card">
      <div class="section-header" style="margin-bottom:12px">
        <span class="section-title">Select Mode</span>
        <span class="pill" id="pomo-total-rounds">0 rounds</span>
      </div>
      <div class="pomo-modes">
        <div class="pomo-mode-card active" onclick="selectPomoMode(0)" id="pmode-0">
          <div class="pomo-mode-title">25 / 5</div>
          <div class="pomo-mode-sub">Classic Pomodoro</div>
          <div class="pomo-mode-tag">Standard</div>
        </div>
        <div class="pomo-mode-card" onclick="selectPomoMode(1)" id="pmode-1">
          <div class="pomo-mode-title">50 / 10</div>
          <div class="pomo-mode-sub">Deep Work</div>
          <div class="pomo-mode-tag">Intense</div>
        </div>
        <div class="pomo-mode-card" onclick="selectPomoMode(2)" id="pmode-2">
          <div class="pomo-mode-title">100 / 20</div>
          <div class="pomo-mode-sub">Flow State</div>
          <div class="pomo-mode-tag">Advanced</div>
        </div>
        <div class="pomo-mode-card" onclick="selectPomoMode(3)" id="pmode-3">
          <div class="pomo-mode-title">200 / 40</div>
          <div class="pomo-mode-sub">Ultra Focus</div>
          <div class="pomo-mode-tag">Elite</div>
        </div>
      </div>
    </div>
    <div class="card" id="pomo-card">
      <div class="pomo-status-bar">
        <span class="pomo-phase-badge work" id="pomo-phase-badge">Work</span>
        <div class="pomo-dots" id="pomo-dots"></div>
        <span class="pomo-rounds" id="pomo-round-label">Round 1</span>
      </div>
      <div class="pomo-display">
        <div class="pomo-big-time" id="pomo-display">25:00</div>
      </div>
      <div class="completion-wrap">
        <div class="completion-header">
          <span class="completion-label" id="pomo-bar-label">Work Session</span>
          <span class="completion-pct" id="pomo-pct">0%</span>
        </div>
        <div class="completion-track"><div class="completion-fill" id="pomo-fill"></div></div>
      </div>
      <div class="btn-row" style="margin-top:4px">
        <button class="btn btn-primary" id="pomo-btn-start" onclick="pomoToggle()">Start</button>
        <button class="btn" id="pomo-btn-skip" onclick="pomoSkip()" disabled>Skip</button>
        <button class="btn btn-danger" id="pomo-btn-reset" onclick="pomoReset()" disabled>Reset</button>
      </div>
    </div>
    <div class="sub-card">
      <div class="section-header">
        <span class="section-title">Today's Rounds</span>
        <span class="pill" id="pomo-today-count">0</span>
      </div>
      <div class="scroll-list" id="pomo-history"><div class="empty-state">No rounds completed yet</div></div>
    </div>
  </div>

  <!-- ══ TASKS ══ -->
  <div class="panel" id="panel-tk">
    <div class="task-add-card">
      <div class="task-add-header">New Task</div>
      <div class="task-input-row">
        <input type="text" class="task-text-input" id="task-input"
          placeholder="What will you focus on?" maxlength="70"
          onkeydown="if(event.key==='Enter')addTask()"/>
        <button class="task-add-btn" onclick="addTask()">+ Add</button>
      </div>
      <!-- Timer type -->
      <div class="task-options-row">
        <span class="task-opt-label">Mode</span>
        <div class="task-type-pills">
          <span class="task-type-pill sel" onclick="selType('stopwatch',this)">Stopwatch</span>
          <span class="task-type-pill" onclick="selType('timer',this)">Timer</span>
          <span class="task-type-pill" onclick="selType('pomodoro',this)">Pomodoro</span>
        </div>
      </div>
      <!-- Duration (shows only when timer selected) -->
      <div class="task-options-row" id="task-dur-row">
        <span class="task-opt-label">Timer</span>
        <div class="task-dur-pills">
          <span class="task-dur-pill sel" onclick="selDur(0,this)">None</span>
          <span class="task-dur-pill" onclick="selDur(5,this)">5m</span>
          <span class="task-dur-pill" onclick="selDur(10,this)">10m</span>
          <span class="task-dur-pill" onclick="selDur(15,this)">15m</span>
          <span class="task-dur-pill" onclick="selDur(25,this)">25m</span>
          <span class="task-dur-pill" onclick="selDur(30,this)">30m</span>
          <span class="task-dur-pill" onclick="selDur(45,this)">45m</span>
          <span class="task-dur-pill" onclick="selDur(60,this)">1h</span>
          <span class="task-dur-pill" onclick="selDur(90,this)">90m</span>
          <span class="task-dur-pill" onclick="selDur(120,this)">2h</span>
        </div>
      </div>
      <!-- Priority -->
      <div class="task-options-row">
        <span class="task-opt-label">Priority</span>
        <div class="task-pri-pills">
          <span class="task-pri-pill sel-low" onclick="selPri('low',this)">Low</span>
          <span class="task-pri-pill" onclick="selPri('med',this)">Medium</span>
          <span class="task-pri-pill" onclick="selPri('high',this)">High</span>
        </div>
      </div>
      <!-- Color -->
      <div class="task-options-row">
        <span class="task-opt-label">Color</span>
        <div class="color-pill-row">
          <div class="task-color-dot c-none sel" onclick="selColor('none',this)" title="None">✕</div>
          <div class="task-color-dot c-v" onclick="selColor('v',this)" title="Violet"></div>
          <div class="task-color-dot c-i" onclick="selColor('i',this)" title="Indigo"></div>
          <div class="task-color-dot c-b" onclick="selColor('b',this)" title="Blue"></div>
          <div class="task-color-dot c-g" onclick="selColor('g',this)" title="Green"></div>
          <div class="task-color-dot c-y" onclick="selColor('y',this)" title="Yellow"></div>
          <div class="task-color-dot c-o" onclick="selColor('o',this)" title="Orange"></div>
          <div class="task-color-dot c-r" onclick="selColor('r',this)" title="Red"></div>
        </div>
      </div>
    </div>

    <div class="sub-card">
      <div class="section-header">
        <span class="section-title">Tasks</span>
        <span class="pill" id="task-count">0</span>
      </div>
      <div class="task-filter-row">
        <button class="task-filter-btn active" onclick="setFilter('all',this)">All</button>
        <button class="task-filter-btn" onclick="setFilter('active',this)">Active</button>
        <button class="task-filter-btn" onclick="setFilter('running',this)">Running</button>
        <button class="task-filter-btn" onclick="setFilter('done',this)">Done</button>
      </div>
      <div class="task-scroll" id="task-list">
        <div class="empty-state">No tasks yet — add one above</div>
      </div>
    </div>

    <!-- ══ GOALS (formerly Mirror) — embedded in Tasks tab ══ -->

    <!-- Goals Summary strip -->
    <div class="mr-summary" id="mr-summary-strip">
      <div class="mr-sum-box"><div class="mr-sum-val" id="mr-sum-today">0m</div><div class="mr-sum-lbl">Today</div></div>
      <div class="mr-sum-box"><div class="mr-sum-val" id="mr-sum-week">0m</div><div class="mr-sum-lbl">This Week</div></div>
      <div class="mr-sum-box"><div class="mr-sum-val" id="mr-sum-tasks">0/0</div><div class="mr-sum-lbl">Goals Done</div></div>
    </div>

    <!-- Create Goal Card -->
    <div class="sub-card" id="mr-add-card">
      <div class="section-header" style="margin-bottom:0">
        <span class="section-title">🪞 Goals</span>
        <button class="mr-new-btn" onclick="MirrorTasks.toggleForm()" id="mirror-form-toggle">+ New Goal</button>
      </div>
      <div id="mirror-create-form" style="display:none;margin-top:16px">
        <div class="mr-form-row">
          <span class="mr-form-lbl">Type</span>
          <div class="task-type-pills">
            <span class="task-type-pill sel" onclick="mrSelType('daily',this)">Daily</span>
            <span class="task-type-pill" onclick="mrSelType('weekly',this)">Weekly Goal</span>
          </div>
        </div>
        <div class="mr-form-field">
          <label class="mr-form-lbl">Name</label>
          <input class="pf-input" id="mr-task-name" placeholder="e.g. Exercise, Deep Work…" type="text" maxlength="60"
            onkeydown="if(event.key==='Enter')MirrorTasks.create()"/>
        </div>
        <div id="mr-daily-fields">
          <div class="mr-form-field">
            <label class="mr-form-lbl">Daily Target</label>
            <div class="mr-hms-row">
              <div class="mr-hms-field"><input class="pf-input mr-hms-input" id="mr-daily-h" placeholder="0" type="number" min="0" max="23"/><span class="mr-hms-unit">h</span></div>
              <div class="mr-hms-field"><input class="pf-input mr-hms-input" id="mr-daily-m" placeholder="30" type="number" min="0" max="59"/><span class="mr-hms-unit">m</span></div>
              <div class="mr-hms-field"><input class="pf-input mr-hms-input" id="mr-daily-s" placeholder="0" type="number" min="0" max="59"/><span class="mr-hms-unit">s</span></div>
            </div>
          </div>
          <div class="mr-form-field">
            <label class="mr-form-lbl">Daily Minimum <span class="mr-form-badge">Non-negotiable</span></label>
            <div class="mr-hms-row">
              <div class="mr-hms-field"><input class="pf-input mr-hms-input" id="mr-min-h" placeholder="0" type="number" min="0" max="23"/><span class="mr-hms-unit">h</span></div>
              <div class="mr-hms-field"><input class="pf-input mr-hms-input" id="mr-min-m" placeholder="20" type="number" min="0" max="59"/><span class="mr-hms-unit">m</span></div>
              <div class="mr-hms-field"><input class="pf-input mr-hms-input" id="mr-min-s" placeholder="0" type="number" min="0" max="59"/><span class="mr-hms-unit">s</span></div>
            </div>
            <div class="mr-form-hint">Leave blank to skip. Sets a floor you commit to each day.</div>
          </div>
        </div>
        <div id="mr-weekly-fields" style="display:none">
          <div class="mr-form-field">
            <label class="mr-form-lbl">Weekly Target (hours)</label>
            <input class="pf-input" id="mr-weekly-hrs" placeholder="e.g. 14" type="number" min="0.5" max="168" step="0.5" oninput="mrPreviewDaily()"/>
          </div>
          <div id="mr-daily-preview" style="display:none" class="mr-preview-box">
            Daily slice: <span id="mr-preview-val" style="color:var(--teal);font-family:'Space Mono',monospace;font-weight:700">—</span>
          </div>
          <div class="mr-form-field">
            <label class="mr-form-lbl">Daily Minimum <span class="mr-form-badge">Non-negotiable</span></label>
            <div class="mr-hms-row">
              <div class="mr-hms-field"><input class="pf-input mr-hms-input" id="mr-wmin-h" placeholder="0" type="number" min="0" max="23"/><span class="mr-hms-unit">h</span></div>
              <div class="mr-hms-field"><input class="pf-input mr-hms-input" id="mr-wmin-m" placeholder="20" type="number" min="0" max="59"/><span class="mr-hms-unit">m</span></div>
            </div>
            <div class="mr-form-hint">Daily non-negotiable regardless of weekly goal.</div>
          </div>
        </div>
        <button class="pf-save-btn" onclick="MirrorTasks.create()" style="margin-top:8px">Add Goal</button>
      </div>
    </div>

    <!-- Goal Lists -->
    <div id="mr-daily-list-wrap">
      <div class="mr-section-header">
        <span class="mr-section-lbl">📅 Daily — <span id="mr-daily-date" style="color:var(--teal)"></span></span>
      </div>
      <div id="mr-daily-list"><div class="empty-state">No daily goals yet</div></div>
    </div>

    <div id="mr-weekly-list-wrap" style="margin-top:8px">
      <div class="mr-section-header">
        <span class="mr-section-lbl">📆 Weekly — <span id="mr-week-range" style="color:var(--teal)"></span></span>
      </div>
      <div id="mr-weekly-list"><div class="empty-state">No weekly goals yet</div></div>
    </div>

  </div>


  <!-- ══ STATISTICS ══ -->
  <div class="panel" id="panel-st">
    <!-- Profile hero at top -->
    <div id="stat-profile-row"></div>

    <div class="sub-card">
      <div class="section-header" style="margin-bottom:12px">
        <span class="section-title">Focus Report</span>
      </div>
      <div class="report-tabs">
        <button class="report-tab active" onclick="switchReport('day')">Day</button>
        <button class="report-tab" onclick="switchReport('week')">Week</button>
        <button class="report-tab" onclick="switchReport('month')">Month</button>
        <button class="report-tab" onclick="switchReport('life')">Lifetime</button>
      </div>
      <div class="report-body" id="report-body"></div>
    </div>

    <!-- Focus Score -->
    <div class="sub-card">
      <div class="section-header" style="margin-bottom:12px">
        <span class="section-title">Focus Score</span>
      </div>
      <div id="focus-score-area"></div>
    </div>

    <!-- Task Completion Rate -->
    <div class="sub-card">
      <div class="section-header" style="margin-bottom:12px">
        <span class="section-title">Task Analytics</span>
      </div>
      <div id="task-analytics-area"></div>
    </div>

    <!-- Heatmap -->
    <div class="sub-card">
      <div class="section-header" style="margin-bottom:12px">
        <span class="section-title">Focus Heatmap</span>
        <span class="pill">24h</span>
      </div>
      <div id="heatmap-area"></div>
    </div>

    <!-- 7 day bar + totals -->
    <div class="sub-card">
      <div class="section-header" style="margin-bottom:6px">
        <span class="section-title">Last 7 Days</span>
      </div>
      <div class="bar-chart" id="bar-chart"></div>
    </div>

    <div class="stats-grid">
      <div class="stat-card"><div class="stat-label">Sessions</div><div class="stat-value sm" id="stat-count">0</div><div class="stat-sub">recorded</div></div>
      <div class="stat-card"><div class="stat-label">Avg Session</div><div class="stat-value sm" id="stat-avg">—</div><div class="stat-sub">per session</div></div>
      <div class="stat-card"><div class="stat-label">Longest</div><div class="stat-value sm" id="stat-longest">—</div><div class="stat-sub">single session</div></div>
      <div class="stat-card"><div class="stat-label">Streak</div><div class="stat-value sm" id="stat-streak">—</div><div class="stat-sub">day streak</div></div>
    </div>

    <!-- Per-task breakdown -->
    <div class="sub-card">
      <div class="section-header" style="margin-bottom:12px">
        <span class="section-title">Per-Task Breakdown</span>
      </div>
      <div id="task-breakdown-area"></div>
    </div>

    <div class="sub-card">
      <div class="section-header">
        <span class="section-title">Session History</span>
        <span class="pill" id="hist-count">0</span>
      </div>
      <div class="sessions-scroll" id="sessions-list"><div class="empty-state">No sessions yet</div></div>
    </div>
    <div style="display:flex;gap:10px;margin-top:4px">
      <button class="clear-btn" onclick="exportData()" style="border-color:var(--border2);color:var(--teal)">⬇ Export Stats</button>
      <button class="clear-btn" onclick="clearStats()">Clear all data</button>
    </div>

    <!-- ══ GOOGLE CALENDAR SYNC ══ -->
    <div class="sub-card" id="gcal-sync-card" style="margin-top:14px">
      <div class="section-header" style="margin-bottom:14px">
        <span class="section-title">📅 Calendar Sync</span>
        <span class="pill" id="gcal-status-pill">Not connected</span>
      </div>

      <!-- Step 1: Client ID setup -->
      <div id="gcal-setup-view">
        <div class="gcal-steps">
          <div class="gcal-step"><span class="gcal-step-num">1</span>Google Cloud Console → APIs &amp; Services → Credentials</div>
          <div class="gcal-step"><span class="gcal-step-num">2</span>Create OAuth 2.0 Client ID (Web app) &amp; add your site URL</div>
          <div class="gcal-step"><span class="gcal-step-num">3</span>Paste Client ID below &amp; connect</div>
        </div>
        <div class="gcal-info-box">
          <div class="gcal-info-title">One-time setup · free · no server needed</div>
          <div class="gcal-info-text">ChronoBlast pushes focus sessions directly to your Google Calendar — all from the browser, nothing leaves your device except the event data.</div>
          <a class="gcal-setup-link" href="https://console.cloud.google.com/apis/credentials" target="_blank" rel="noopener">→ Open Google Cloud Console</a>
        </div>
        <div class="gcal-input-row">
          <input type="text" class="pf-input gcal-client-input" id="gcal-client-id-input"
            placeholder="Paste your OAuth 2.0 Client ID  (ends in .apps.googleusercontent.com)"
            autocomplete="off" spellcheck="false"/>
          <div class="gcal-err" id="gcal-setup-err"></div>
          <button class="btn btn-primary" onclick="GCalSync.saveClientId()" style="width:100%">Save &amp; Continue →</button>
        </div>
      </div>

      <!-- Step 2: Client ID saved, needs auth -->
      <div id="gcal-connect-view" style="display:none">
        <div class="gcal-info-box" style="margin-bottom:12px">
          <div class="gcal-info-text">Client ID saved. Click below to authorize ChronoBlast to create calendar events on your behalf. A Google pop-up will appear.</div>
        </div>
        <button class="btn btn-primary gcal-sync-btn" onclick="GCalSync.connect()">🔗 Connect Google Calendar</button>
        <div style="text-align:center">
          <button class="gcal-disconnect-btn" onclick="GCalSync.clearClientId()">✕ Remove Client ID</button>
        </div>
      </div>

      <!-- Step 3: Connected -->
      <div id="gcal-connected-view" style="display:none">
        <div class="gcal-connected-row">
          <div class="gcal-dot live"></div>
          <span class="gcal-account-label" id="gcal-account-label">Google Calendar connected</span>
          <button class="gcal-disconnect-btn" onclick="GCalSync.disconnect()">Disconnect</button>
        </div>
        <div class="gcal-sync-stats" id="gcal-sync-stats">
          <div class="gcal-sync-stat-row"><span>Unsynced sessions</span><span class="gcal-sync-stat-val" id="gcal-unsynced-count">—</span></div>
          <div class="gcal-sync-stat-row"><span>Total sessions synced</span><span class="gcal-sync-stat-val" id="gcal-total-synced">—</span></div>
          <div class="gcal-sync-stat-row"><span>Last sync</span><span class="gcal-sync-stat-val" id="gcal-last-sync">Never</span></div>
        </div>
        <button class="btn btn-primary gcal-sync-btn" id="gcal-sync-btn" onclick="GCalSync.syncAll()">📤 Sync Sessions to Google Calendar</button>
        <div class="gcal-log" id="gcal-log"></div>
      </div>
    </div>
  </div>

  <!-- ══ PROFILE (modal only, no dedicated tab) ══ -->
  <div class="panel" id="panel-pf" style="display:none!important"></div>

</div>

<script>
// ═══════════════════════════════════════════════════════════════
// CHRONOBLAST — REFACTORED ARCHITECTURE
// Modules: Audio | Helpers | Storage | Visibility | Tabs
//          Stopwatch | Timer | Pomodoro | Tasks | Mirror
//          Profile | Statistics | Keyboard
// ═══════════════════════════════════════════════════════════════

// ── MODULE: AUDIO ───────────────────────────────────────────────
const Audio = (() => {
  const AC = window.AudioContext || window.webkitAudioContext;
  let ctx = null;
  const ensure = () => { if (!ctx) ctx = new AC(); };

  const tone = (freq, type='sine', dur=0.08, vol=0.12, delay=0) => {
    ensure();
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    o.type = type; o.frequency.value = freq;
    const t = ctx.currentTime + delay;
    g.gain.setValueAtTime(0, t);
    g.gain.linearRampToValueAtTime(vol, t + 0.01);
    g.gain.exponentialRampToValueAtTime(0.001, t + dur);
    o.start(t); o.stop(t + dur + 0.02);
  };

  return {
    ensure,
    start:   () => { tone(660,'sine',0.12,0.1); tone(880,'sine',0.08,0.05,0.05); },
    pause:   () => { tone(550,'sine',0.1,0.09); },
    lap:     () => { tone(780,'sine',0.07,0.08); tone(920,'sine',0.06,0.06,0.06); },
    tick:    () => { tone(1200,'sine',0.03,0.04); },
    phase:   () => { tone(523,'sine',0.15,0.1); tone(659,'sine',0.15,0.1,0.12); tone(784,'sine',0.2,0.12,0.24); },
    // Timer done — soft ascending chime, feels like release not alarm
    done: () => {
      [[0,440],[0.15,554],[0.3,659],[0.48,784],[0.68,880]].forEach(([d,f]) => {
        tone(f,'sine',0.45,0.11,d);
        if(d > 0) tone(f*0.5,'sine',0.4,0.04,d); // warm undertone
      });
    },
    // Task complete — distinct from timer done, feels like achievement
    taskDone: () => {
      tone(523,'sine',0.12,0.09);
      tone(659,'sine',0.18,0.12,0.1);
      tone(784,'sine',0.22,0.13,0.22);
      tone(1046,'sine',0.3,0.1,0.36);
      // Warm harmonic layer
      tone(392,'sine',0.35,0.05,0.1);
    },
    // Pomodoro work complete — more celebratory
    pomoDone: () => {
      [0,0.12,0.26,0.42,0.6].forEach((d,i) => {
        const freqs = [523,659,784,880,1046];
        tone(freqs[i],'sine',0.28,0.13,d);
      });
      tone(261,'sine',0.5,0.06,0.1);
    }
  };
})();

// ── MODULE: FOCUS MUSIC ──────────────────────────────────────────
// Synthesizes real musical focus audio via Web Audio API.
// NO static noise — three scientifically-backed soundscapes:
//
//  ⚡ Focus     — 40 Hz gamma binaural beat layered over a warm
//                 432 Hz drone chord (root + fifth + octave),
//                 with a slow 0.1 Hz amplitude breath for depth.
//                 Gamma entrainment → sharper attention & recall.
//
//  🌊 Deep Work — 14 Hz alpha/beta binaural over a slow evolving
//                 pentatonic arpeggio (D-F#-A-D, 70 BPM feel),
//                 filtered through a gentle low-pass so it sits
//                 far in the background — not distracting.
//
//  🍃 Calm Flow — 10 Hz alpha binaural over a soft ambient pad:
//                 three detuned sine oscillators making a lush
//                 major-7th chord (C-E-G-B) that slowly drifts
//                 with LFO vibrato. Ideal for reading/writing.
//
// All notes are synthesized locally — zero network requests.
const FocusMusic = (() => {
  const AC = window.AudioContext || window.webkitAudioContext;
  let ctx = null, masterGain = null;
  let _nodes = [];   // all active nodes for teardown
  let _playing = false;
  let _vol = 0.5;
  let _profile = 'focus';
  let _fadeTimer = null;

  const PROFILES = {
    focus: { desc: '40 Hz gamma · Harmonic drone' },
    deep:  { desc: '14 Hz alpha · Pentatonic pulse' },
    calm:  { desc: '10 Hz alpha · Ambient pad' },
  };

  const ensure = () => {
    if (!ctx) {
      ctx = new AC();
      masterGain = ctx.createGain();
      masterGain.gain.value = 0;   // start silent, fade in
      masterGain.connect(ctx.destination);
    }
    if (ctx.state === 'suspended') ctx.resume();
  };

  // Helper — create & track an oscillator
  const osc = (freq, type = 'sine', detune = 0) => {
    const o = ctx.createOscillator();
    o.type = type; o.frequency.value = freq; o.detune.value = detune;
    _nodes.push(o); return o;
  };

  // Helper — create & track a gain node
  const gain = (val = 1) => {
    const g = ctx.createGain(); g.gain.value = val;
    _nodes.push(g); return g;
  };

  // Helper — create & track a biquad filter
  const filter = (type, freq, q = 1) => {
    const f = ctx.createBiquadFilter();
    f.type = type; f.frequency.value = freq; f.Q.value = q;
    _nodes.push(f); return f;
  };

  // Binaural beat: LEFT = carrier, RIGHT = carrier + beatFreq
  // Returns a stereo merger node ready to connect downstream.
  const makeBinaural = (carrier, beatFreq, vol = 0.07) => {
    const merger = ctx.createChannelMerger(2);
    _nodes.push(merger);
    const L = osc(carrier), R = osc(carrier + beatFreq);
    const gL = gain(vol), gR = gain(vol);
    L.connect(gL); gL.connect(merger, 0, 0);
    R.connect(gR); gR.connect(merger, 0, 1);
    L.start(); R.start();
    return merger;
  };

  // Slow LFO for amplitude breathing / vibrato
  const makeLFO = (rate, depth, target, param) => {
    const l = osc(rate);
    const lg = gain(depth);
    l.connect(lg); lg.connect(param);
    l.start();
  };

  // ── PROFILE: FOCUS ────────────────────────────────────────────
  // Warm drone chord (432 Hz root, fifth 648, octave 864) +
  // 40 Hz gamma binaural beat + slow amplitude breath.
  const buildFocus = () => {
    // Drone chord — three detuned sine layers
    const freqs = [216, 432, 648, 864];
    const vols  = [0.08, 0.13, 0.09, 0.06];
    freqs.forEach((f, i) => {
      const o = osc(f, 'sine', (i % 2 === 0 ? -3 : 3));
      const g = gain(vols[i]);
      // Slow LFO breath on each layer — slightly different rates
      makeLFO(0.07 + i * 0.013, vols[i] * 0.35, null, g.gain);
      o.connect(g); g.connect(masterGain);
      o.start();
    });
    // 40 Hz gamma binaural (432 Hz carrier)
    const bin = makeBinaural(432, 40, 0.06);
    bin.connect(masterGain);
  };

  // ── PROFILE: DEEP WORK ────────────────────────────────────────
  // Slow pentatonic pulse (D-F#-A-D at ~0.9 Hz = 54 BPM feel)
  // filtered low so it's felt more than heard. 14 Hz alpha beat.
  const buildDeep = () => {
    // Pentatonic notes: D3 D4 A3 F#3 (Hz)
    const notes = [146.83, 293.66, 220.00, 185.00, 293.66, 220.00];
    const seqGain = gain(0.0);
    const lpf = filter('lowpass', 900, 0.8);
    seqGain.connect(lpf); lpf.connect(masterGain);

    let step = 0;
    const stepDur = 0.85; // seconds per note
    const scheduleNote = () => {
      if (!_playing) return;
      const now = ctx.currentTime;
      const freq = notes[step % notes.length];
      const o = osc(freq, 'sine');
      const g = gain(0);
      o.connect(g); g.connect(seqGain);
      o.start(now);
      // Soft attack/decay envelope
      g.gain.setValueAtTime(0, now);
      g.gain.linearRampToValueAtTime(0.22, now + 0.12);
      g.gain.exponentialRampToValueAtTime(0.001, now + stepDur * 0.88);
      o.stop(now + stepDur);
      step++;
      const t = setTimeout(scheduleNote, stepDur * 950);
      _nodes.push({ stop: () => clearTimeout(t) });
    };
    // Fade in the sequence gain
    seqGain.gain.setTargetAtTime(1, ctx.currentTime + 0.5, 0.4);
    scheduleNote();

    // Subtle pad underneath (perfect fifth)
    const pad1 = osc(146.83, 'sine', -5);
    const pad2 = osc(220.00, 'sine',  5);
    const padG = gain(0.07);
    pad1.connect(padG); pad2.connect(padG); padG.connect(masterGain);
    makeLFO(0.05, 0.025, null, padG.gain);
    pad1.start(); pad2.start();

    // 14 Hz alpha binaural (293 Hz carrier)
    const bin = makeBinaural(293, 14, 0.06);
    bin.connect(masterGain);
  };

  // ── PROFILE: CALM FLOW ────────────────────────────────────────
  // Lush major-7th ambient pad (C-E-G-B detuned cluster) +
  // 10 Hz alpha binaural + slow vibrato LFO.
  const buildCalm = () => {
    // Cmaj7 chord: C3 E3 G3 B3 C4 — detuned for shimmer
    const chord = [
      { f: 130.81, det: 0,   v: 0.10 },
      { f: 164.81, det: -6,  v: 0.09 },
      { f: 196.00, det:  5,  v: 0.08 },
      { f: 246.94, det: -4,  v: 0.07 },
      { f: 261.63, det:  3,  v: 0.06 },
      { f: 329.63, det: -2,  v: 0.05 },
    ];
    chord.forEach(({ f, det, v }) => {
      const o = osc(f, 'sine', det);
      const g = gain(v);
      // Each layer breathes at a slightly different rate
      makeLFO(0.04 + Math.random() * 0.04, v * 0.4, null, g.gain);
      o.connect(g); g.connect(masterGain);
      o.start();
    });

    // Soft octave overtone layer
    const ot = osc(523.25, 'sine', 0);
    const otG = gain(0.03);
    makeLFO(0.08, 0.015, null, otG.gain);
    ot.connect(otG); otG.connect(masterGain);
    ot.start();

    // 10 Hz alpha binaural (261 Hz carrier)
    const bin = makeBinaural(261, 10, 0.055);
    bin.connect(masterGain);
  };

  const buildGraph = () => {
    if (_profile === 'focus') buildFocus();
    else if (_profile === 'deep') buildDeep();
    else buildCalm();
  };

  const teardown = () => {
    _nodes.forEach(n => {
      try { if (typeof n.stop === 'function') n.stop(); } catch(e){}
      try { if (typeof n.disconnect === 'function') n.disconnect(); } catch(e){}
    });
    _nodes = [];
  };

  // Smooth fade in/out via masterGain
  const fadeTo = (target, durSec, cb) => {
    if (!masterGain) return cb && cb();
    masterGain.gain.cancelScheduledValues(ctx.currentTime);
    masterGain.gain.setValueAtTime(masterGain.gain.value, ctx.currentTime);
    masterGain.gain.linearRampToValueAtTime(target, ctx.currentTime + durSec);
    if (cb) {
      if (_fadeTimer) clearTimeout(_fadeTimer);
      _fadeTimer = setTimeout(cb, durSec * 1000 + 20);
    }
  };

  const obj = {
    play() {
      ensure();
      if (_playing) return;
      _playing = true;
      buildGraph();
      fadeTo(_vol, 1.2);
      _updateUI();
    },
    pause() {
      if (!_playing) return;
      fadeTo(0, 0.8, () => {
        teardown();
        _updateUI();
      });
      _playing = false;
      _updateUI();
    },
    stop() { obj.pause(); },
    toggle() { _playing ? obj.pause() : obj.play(); },
    isPlaying() { return _playing; },
    setVolume(v) {
      _vol = Math.max(0, Math.min(1, v));
      if (masterGain && _playing) masterGain.gain.setTargetAtTime(_vol, ctx.currentTime, 0.1);
      _updateUI();
    },
    setProfile(p) {
      const was = _playing;
      if (was) {
        fadeTo(0, 0.4, () => { teardown(); _profile = p; if (was) { _playing = true; buildGraph(); fadeTo(_vol, 0.8); } _updateUI(); });
        _playing = false;
      } else {
        _profile = p;
      }
      _updateUI();
    },
    getProfile() { return _profile; },
    getProfileMeta() { return PROFILES[_profile]; },
    getAllProfiles() { return PROFILES; },
  };

  function _updateUI() {
    // Pill button
    const pill = document.getElementById('fm-pill');
    const pillLabel = document.getElementById('fm-pill-label');
    // Popup play button
    const playBtn = document.getElementById('fm-popup-play-btn');
    // Desc
    const desc = document.getElementById('fm-desc');
    // Vol slider
    const volSlider = document.getElementById('fm-popup-vol');

    if (pill) pill.classList.toggle('playing', _playing);
    if (pillLabel) pillLabel.textContent = _playing ? 'Playing' : 'Music';

    if (playBtn) {
      playBtn.textContent = _playing ? '⏸  Pause' : '▶  Play';
      playBtn.classList.toggle('playing', _playing);
    }
    const p = PROFILES[_profile];
    if (desc) desc.textContent = p.desc;
    if (volSlider) volSlider.value = Math.round(_vol * 100);
    document.getElementById('fm-popup-vol-val') && (document.getElementById('fm-popup-vol-val').textContent = Math.round(_vol * 100) + '%');

    // Profile buttons
    ['focus','deep','calm'].forEach(k => {
      const pb = document.getElementById('fm-p-' + k);
      if (pb) pb.classList.toggle('active', k === _profile);
    });
  }

  return obj;
})();

function fmToggle(){ FocusMusic.toggle(); }
function fmVolume(v){ FocusMusic.setVolume(v / 100); }
function fmProfile(p){ FocusMusic.setProfile(p); }

// Toggle the popup panel open/closed
function fmPillClick() {
  const popup = document.getElementById('fm-panel-popup');
  if (!popup) return;
  popup.classList.toggle('open');
}
// Close popup when clicking outside
document.addEventListener('click', e => {
  const pill  = document.getElementById('fm-pill');
  const popup = document.getElementById('fm-panel-popup');
  if (!popup || !pill) return;
  if (popup.classList.contains('open') && !popup.contains(e.target) && !pill.contains(e.target)) {
    popup.classList.remove('open');
  }
}, { passive: true });

// ── MODULE: HELPERS ──────────────────────────────────────────────
const Fmt = (() => {
  const p2 = n => String(Math.floor(n)).padStart(2,'0');
  return {
    p2,
    ms:  ms => { const s=Math.floor(ms/1000),m=Math.floor(s/60),cs=Math.floor((ms%1000)/10); return `${p2(m)}:${p2(s%60)}<span class="ms">.${p2(cs)}</span>`; },
    hms: ms => { const s=Math.floor(ms/1000),h=Math.floor(s/3600),m=Math.floor((s%3600)/60),cs=Math.floor((ms%1000)/10); return h>0?`${p2(h)}:${p2(m)}:${p2(s%60)}<span class="ms">.${p2(cs)}</span>`:`${p2(m)}:${p2(s%60)}<span class="ms">.${p2(cs)}</span>`; },
    mss: ms => { const s=Math.floor(ms/1000),m=Math.floor(s/60); return `${p2(m)}:${p2(s%60)}`; },
    dur: ms => { const s=Math.floor(ms/1000),h=Math.floor(s/3600),m=Math.floor((s%3600)/60),ss=s%60; if(h>0)return`${h}h ${m}m`; if(m>0)return`${m}m ${ss}s`; return`${ss}s`; },
    durShort: ms => { const h=Math.floor(ms/3600000),m=Math.floor((ms%3600000)/60000),s=Math.floor((ms%60000)/1000); if(h>0)return`${h}h ${m}m`; if(m>0)return`${m}m`; return`${s}s`; },
    todayKey: () => new Date().toISOString().slice(0,10),
    weekStart: () => { const d=new Date(); d.setDate(d.getDate()-d.getDay()); d.setHours(0,0,0,0); return d; },
    monthKey: () => new Date().toISOString().slice(0,7),
    escHtml: s => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'),
  };
})();

// ── MODULE: SECOND PULSE (premium soft tick on every second boundary) ──
const SecondPulse = (() => {
  const _last = {};
  return {
    pulse(el, ms) {
      const sec = Math.floor(ms / 1000);
      const key = el.id || el;
      if (_last[key] !== sec) {
        _last[key] = sec;
        el.classList.remove('tick-flash');
        // Force reflow to restart animation
        void el.offsetWidth;
        el.classList.add('tick-flash');
      }
    }
  };
})();
const Store = (() => {
  const get = (key, fallback) => { try { return JSON.parse(localStorage.getItem(key) || 'null') ?? fallback; } catch { return fallback; } };
  const set = (key, val) => { try { localStorage.setItem(key, JSON.stringify(val)); } catch(e) { console.warn('Storage full', e); } };
  return {
    sessions: { load: () => get('cb_sessions',[]), save: v => set('cb_sessions',v) },
    tasks:    { load: () => get('cb_tasks2',[]),   save: v => set('cb_tasks2',v) },
    profile:  { load: () => get('cb_profile',null),save: v => set('cb_profile',v) },
    mirror:   { load: () => get('cb_mirror',{goals:[],dailyGoals:[],activeGoalId:null}), save: v => set('cb_mirror',v) },
    record: (type, ms, taskName='', goalId=null) => {
      if (ms < 3000) return;
      const s = Store.sessions.load();
      s.unshift({ type, ms, date: new Date().toISOString(), taskName, hour: new Date().getHours(), goalId });
      Store.sessions.save(s);
      // Refresh Mirror after crediting a session
      if (goalId && typeof MirrorTasks !== 'undefined') MirrorTasks.render();
    }
  };
})();

// ── MODULE: PAGE VISIBILITY (Browser-proof timing) ───────────────
const Visibility = (() => {
  const handlers = [];
  document.addEventListener('visibilitychange', () => {
    handlers.forEach(fn => fn(document.hidden));
  });
  return {
    onHide: fn => handlers.push(fn),
    isHidden: () => document.hidden,
  };
})();

// ── BACKGROUND-SAFE TICKER ────────────────────────────────────────
// RAF when visible (smooth, compositor-synced).
// setTimeout when hidden (keeps timing accurate in background).
// Single loop per ticker — no double-scheduling.
function makeTicker(fn, intervalMs) {
  let _running = false;
  let _rafId   = null;
  let _stId    = null;
  let _last    = 0;

  const _rafLoop = (ts) => {
    if (!_running) return;
    if (ts - _last >= intervalMs) { _last = ts; fn(); }
    _rafId = requestAnimationFrame(_rafLoop);
  };

  const _stLoop = () => {
    if (!_running) return;
    fn();
    _stId = setTimeout(_stLoop, intervalMs);
  };

  const _onVis = () => {
    if (!_running) return;
    if (document.hidden) {
      if (_rafId) { cancelAnimationFrame(_rafId); _rafId = null; }
      _stId = setTimeout(_stLoop, intervalMs);
    } else {
      if (_stId) { clearTimeout(_stId); _stId = null; }
      _last = 0;
      _rafId = requestAnimationFrame(_rafLoop);
    }
  };
  document.addEventListener('visibilitychange', _onVis, { passive: true });

  return {
    start() {
      if (_running) return;
      _running = true; _last = 0;
      if (document.hidden) { _stId = setTimeout(_stLoop, intervalMs); }
      else { _rafId = requestAnimationFrame(_rafLoop); }
    },
    stop() {
      _running = false;
      if (_rafId) { cancelAnimationFrame(_rafId); _rafId = null; }
      if (_stId)  { clearTimeout(_stId);          _stId  = null; }
    },
    isRunning() { return _running; }
  };
}

// ── MODULE: TABS ──────────────────────────────────────────────────
const TAB_IDS = ['sw','tm','pm','tk','st'];
function switchTab(id) {
  const current = TAB_IDS.find(t => document.getElementById('panel-'+t).classList.contains('active'));
  if (current === id) return;

  const outEl = current ? document.getElementById('panel-'+current) : null;
  const inEl  = document.getElementById('panel-'+id);

  // Update tab buttons immediately
  TAB_IDS.forEach((t,i) => {
    document.querySelectorAll('.tab')[i].classList.toggle('active', t===id);
  });

  const doSwitch = () => {
    if (outEl) { outEl.classList.remove('active','exit'); }
    inEl.classList.add('active');
    if (id==='st') { Stats.render(); GCalSync.refresh(); }
    if (id==='pm') Pomo.renderHistory();
    if (id==='mr') Mirror.render();
    if (id==='tk') MirrorTasks.render();
  };

  if (outEl) {
    outEl.classList.add('exit');
    outEl.addEventListener('animationend', function handler() {
      outEl.removeEventListener('animationend', handler);
      doSwitch();
    }, { once: true });
  } else {
    doSwitch();
  }
}

// ── MODULE: STOPWATCH ─────────────────────────────────────────────
const SW = (() => {
  let run=false, startTs=0, elapsed=0, laps=[];
  const display  = document.getElementById('sw-display');
  const btnStart = document.getElementById('sw-btn-start');
  const btnLap   = document.getElementById('sw-btn-lap');
  const btnReset = document.getElementById('sw-btn-reset');
  const card     = document.getElementById('sw-card');
  const progFill = document.getElementById('sw-progress-fill');

  const tick = () => {
    elapsed = Date.now() - startTs;
    display.innerHTML = Fmt.ms(elapsed);
    progFill.style.width = ((elapsed % 60000) / 60000 * 100) + '%';
    SecondPulse.pulse(display, elapsed);
  };

  const ticker = makeTicker(tick, 80);

  return {
    toggle() {
      Audio.ensure();
      if (!run) {
        startTs = Date.now() - elapsed; run = true;
        ticker.start();
        display.classList.add('running'); card.classList.add('running-glow');
        btnStart.textContent = 'Pause'; btnLap.disabled = false; btnReset.disabled = false;
        Audio.start();
      } else {
        ticker.stop(); run = false;
        display.classList.remove('running'); card.classList.remove('running-glow');
        btnStart.textContent = 'Resume'; btnLap.disabled = true;
        Audio.pause();
      }
    },
    lap() {
      if (!run) return; Audio.lap();
      const prev = laps.reduce((a,l) => a+l.ms, 0);
      laps.unshift({ ms: elapsed - prev, num: laps.length + 1 });
      this.renderLaps();
    },
    reset() {
      const capturedMs = elapsed;
      ticker.stop(); run = false; elapsed = 0; laps = [];
      display.innerHTML = '00:00<span class="ms">.00</span>';
      display.classList.remove('running'); card.classList.remove('running-glow');
      progFill.style.width = '0%';
      btnStart.textContent = 'Start'; btnLap.disabled = true; btnReset.disabled = true;
      this.renderLaps(); Audio.pause();
      // Bug 2 fix: show CreditToast (consistent with Timer/Pomo) instead of silent record
      if (capturedMs > 3000) {
        const activeGoalId = Mirror.getActiveId();
        if (activeGoalId) {
          const mirrorData = Store.mirror.load();
          const allGoals = [...(mirrorData.goals||[]), ...(mirrorData.dailyGoals||[]).map(g=>({...g,id:'d_'+g.id}))];
          const goalObj = allGoals.find(g=>String(g.id)===String(activeGoalId));
          const goalName = goalObj ? goalObj.name : 'Active Goal';
          CreditToast.autoCredit(activeGoalId, goalName, capturedMs);
        } else {
          Store.record('Stopwatch', capturedMs, '', null);
        }
      }
    },
    renderLaps() {
      document.getElementById('lap-count').textContent = `${laps.length} lap${laps.length!==1?'s':''}`;
      const ll = document.getElementById('lap-list');
      if (!laps.length) { ll.innerHTML = '<div class="empty-state">No laps recorded</div>'; return; }
      const times = laps.map(l => l.ms), best = Math.min(...times), worst = Math.max(...times);
      ll.innerHTML = laps.map((l,i) => {
        const cls = laps.length>1 ? (l.ms===best?'best':l.ms===worst?'worst':'') : '';
        const badge = cls==='best' ? '<span class="lap-badge badge-best">Best</span>' : cls==='worst' ? '<span class="lap-badge badge-slow">Slow</span>' : '';
        return `<div class="lap-item ${cls}"><span class="lap-num">Lap ${laps.length-i}</span><span class="lap-time">${Fmt.ms(l.ms)}</span><div class="lap-badges">${badge}</div></div>`;
      }).join('');
    }
  };
})();
