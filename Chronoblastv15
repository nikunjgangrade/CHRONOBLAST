// ── MODULE: TIMER ─────────────────────────────────────────────────
const TM = (() => {
  let run=false, startTs=0, total=0, rem=0, orig=0, lastWarnTick=-1;
  const display  = document.getElementById('tm-display');
  const btnSet   = document.getElementById('tm-btn-set');
  const btnStart = document.getElementById('tm-btn-start');
  const btnReset = document.getElementById('tm-btn-reset');
  const ring     = document.getElementById('ring-fill');
  const card     = document.getElementById('tm-card');
  const CIRC     = 515;

  const tick = () => {
    const el = Date.now() - startTs;
    rem = Math.max(0, total - el);
    ring.style.strokeDashoffset = (CIRC * (rem / orig)).toFixed(2);
    display.innerHTML = Fmt.hms(rem);
    SecondPulse.pulse(display, rem);
    const pct = Math.round((1 - rem/orig) * 100);
    const fill = document.getElementById('tm-fill');
    const pctEl = document.getElementById('tm-pct');
    if (fill) { fill.style.width = pct + '%'; pctEl.textContent = pct + '%'; }
    if (pct >= 90) { fill && fill.classList.add('warn'); pctEl && pctEl.classList.add('warn'); }
    else { fill && fill.classList.remove('warn'); pctEl && pctEl.classList.remove('warn'); }
    if (rem <= 10000 && rem > 0) {
      display.classList.add('warning'); display.classList.remove('running');
      const sec = Math.floor(rem/1000);
      if (sec !== lastWarnTick) { lastWarnTick = sec; Audio.tick(); }
    } else if (rem > 10000) { display.classList.remove('warning'); }
    if (rem <= 0) {
      ticker.stop(); run = false;
      display.className = 'time-display done';
      display.innerHTML = '00:00<span class="ms">.00</span>';
      if (fill) { fill.style.width = '100%'; fill.className = 'completion-fill done-fill'; }
      if (pctEl) pctEl.textContent = '100%';
      btnStart.textContent = 'Start'; btnStart.classList.add('btn-primary'); btnStart.disabled = true;
      document.getElementById('done-bar').classList.add('show');
      card.classList.remove('running-glow');
      const activeGoalId = Mirror.getActiveId();
      if (activeGoalId) {
        // Auto-credit immediately — no toast timeout to race against (Mirror fix)
        Store.record('Timer', orig, '', activeGoalId);
        Mirror.render();
        CreditToast.showConfirmed(activeGoalId, orig);
      } else {
        Store.record('Timer', orig, '', null);
      }
      Audio.done();
    }
  };

  const ticker = makeTicker(tick, 250);

  return {
    set() {
      const h = parseInt(document.getElementById('tm-h').value)||0;
      const m = parseInt(document.getElementById('tm-m').value)||0;
      const s = parseInt(document.getElementById('tm-s').value)||0;
      total = (h*3600+m*60+s)*1000; if (!total) return;
      orig = total; rem = total;
      document.getElementById('tm-input-section').style.display = 'none';
      document.getElementById('tm-ring-wrap').classList.add('show');
      document.getElementById('done-bar').classList.remove('show');
      const cw = document.getElementById('tm-completion'); cw.style.display = 'block';
      document.getElementById('tm-pct').textContent = '0%';
      document.getElementById('tm-fill').style.width = '0%';
      document.getElementById('tm-fill').className = 'completion-fill';
      display.className = 'time-display'; display.innerHTML = Fmt.hms(total);
      ring.style.strokeDashoffset = '0';
      btnSet.disabled = true; btnStart.disabled = false; btnReset.disabled = false;
      Audio.start();
    },
    toggle() {
      Audio.ensure();
      if (!run) {
        startTs = Date.now() - (orig - rem); run = true;
        ticker.start();
        display.classList.add('running'); display.classList.remove('warning');
        card.classList.add('running-glow');
        btnStart.textContent = 'Pause'; btnStart.classList.remove('btn-primary');
        Audio.start();
      } else {
        ticker.stop(); run = false;
        display.classList.remove('running'); card.classList.remove('running-glow');
        btnStart.textContent = 'Resume'; btnStart.classList.add('btn-primary');
        Audio.pause();
      }
    },
    reset() {
      ticker.stop(); run = false; rem = 0; total = 0; orig = 0; lastWarnTick = -1;
      document.getElementById('tm-input-section').style.display = '';
      document.getElementById('tm-ring-wrap').classList.remove('show');
      document.getElementById('done-bar').classList.remove('show');
      document.getElementById('tm-completion').style.display = 'none';
      display.className = 'time-display'; display.innerHTML = '00:00<span class="ms">.00</span>';
      ring.style.strokeDashoffset = '0'; card.classList.remove('running-glow');
      btnSet.disabled = false; btnStart.disabled = true; btnReset.disabled = true;
      btnStart.textContent = 'Start'; btnStart.classList.add('btn-primary');
      Audio.pause();
    }
  };
})();
function tmSet(){ TM.set(); }
function tmToggle(){ TM.toggle(); }
function tmReset(){ TM.reset(); }
