      document.getElementById('bar-chart').innerHTML=days.map((dk,i)=>{const h=Math.max(4,Math.round((totals[i]/mx)*58)),isT=dk===Fmt.todayKey();return`<div class="bar-col"><div class="bar${isT?' today':''}" style="height:${h}px"></div><span class="bar-day${isT?' today':''}">${dn[new Date(dk+'T12:00:00').getDay()]}</span></div>`;}).join('');
