      document.getElementById('focus-score-area').innerHTML=`<div class="focus-score-wrap"><div class="focus-score-ring"><svg class="fs-svg" width="96" height="96" viewBox="0 0 96 96"><defs><linearGradient id="fsGrad" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#00bfa6"/><stop offset="100%" stop-color="#00e6c8"/></linearGradient></defs><circle class="fs-bg" cx="48" cy="48" r="${r}" stroke-width="5"/><circle class="fs-fill" cx="48" cy="48" r="${r}" stroke-width="5" stroke-dasharray="${circ.toFixed(1)}" stroke-dashoffset="${offset.toFixed(1)}"/></svg><div class="fs-center"><div class="fs-num">${score}</div><div class="fs-lbl-s">Score</div></div></div><div class="focus-score-info"><div class="fs-title">Today's Rating</div><div class="fs-grade">${grade}</div><div class="fs-desc">${desc}</div></div></div>`;
      // Task analytics
      const allT=Store.tasks.load(),total2=allT.length,done2=allT.filter(t=>t.done).length,rate=total2?Math.round((done2/total2)*100):0;
      document.getElementById('task-analytics-area').innerHTML=`<div class="rate-grid"><div class="rate-box"><div class="rate-val">${rate}%</div><div class="rate-lbl">Completion</div></div><div class="rate-box"><div class="rate-val">${done2}</div><div class="rate-lbl">Done</div></div><div class="rate-box"><div class="rate-val">${total2-done2}</div><div class="rate-lbl">Active</div></div></div><div class="report-bar-wrap" style="margin-top:8px"><div class="report-bar-label"><span>Completion Rate</span><span>${rate}%</span></div><div class="report-bar-track"><div class="report-bar-fill" style="width:${rate}%"></div></div></div>`;
      // Heatmap
