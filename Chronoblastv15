      const firstDay=new Date(year,month,1).getDay(),daysInMonth=new Date(year,month+1,0).getDate();
      const sd={};
      sessions.filter(s=>s.date.slice(0,7)===Fmt.monthKey()).forEach(s=>{const d=s.date.slice(8,10);sd[d]=(sd[d]||0)+s.ms;});
      let h=`<div class="mini-cal"><div class="mini-cal-header">${now.toLocaleString('default',{month:'long'})} ${year}</div><div class="mini-cal-grid">`;
