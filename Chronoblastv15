// ── MODULE: POMODORO ──────────────────────────────────────────────
const Pomo = (() => {
  const MODES = [{work:25,rest:5},{work:50,rest:10},{work:100,rest:20},{work:200,rest:40}];
  let mode=0, phase='work', round=1, run=false;
  let startTs=0, rem=0, orig=0, rounds=[], lastTick=-1;

  const tick = () => {
    rem = Math.max(0, orig - (Date.now() - startTs));
    document.getElementById('pomo-display').textContent = Fmt.mss(rem);
    const pct = Math.round((1 - rem/orig) * 100);
    document.getElementById('pomo-pct').textContent = pct + '%';
    document.getElementById('pomo-fill').style.width = pct + '%';
    if (rem <= 10000 && rem > 0) {
      document.getElementById('pomo-display').classList.add('warning');
      const sec = Math.floor(rem/1000);
      if (sec !== lastTick) { lastTick = sec; Audio.tick(); }
    }
    if (rem <= 0) { ticker.stop(); phaseEnd(); }
  };

  const ticker = makeTicker(tick, 250);

  const phaseEnd = () => {
    const m = MODES[mode];
    if (phase === 'work') {
      const workMs = m.work*60000;
      rounds.push({ round, phase:'work', ms:workMs, date:new Date().toISOString() });
      const activeGoalId = Mirror.getActiveId();
      if (activeGoalId) {
        // Auto-credit immediately — no toast timeout to race against (Mirror fix)
        Store.record('Pomodoro', workMs, '', activeGoalId);
        Mirror.render();
        CreditToast.showConfirmed(activeGoalId, workMs);
      } else {
        Store.record('Pomodoro', workMs, '', null);
      }
      phase='rest'; orig=m.rest*60000; rem=orig; lastTick=-1;
      document.getElementById('pomo-phase-badge').textContent = 'Rest';
      document.getElementById('pomo-phase-badge').className = 'pomo-phase-badge rest';
      document.getElementById('pomo-bar-label').textContent = 'Break';
      document.getElementById('pomo-fill').className = 'completion-fill warn';
      document.getElementById('pomo-display').className = 'pomo-big-time rest-run';
      document.getElementById('pomo-display').textContent = Fmt.mss(rem);
      document.getElementById('pomo-pct').textContent = '0%';
      document.getElementById('pomo-fill').style.width = '0%';
      Audio.pomoDone();
      startTs = Date.now();
      ticker.start();
      Pomo.renderHistory();
    } else {
      phase='work'; round++; lastTick=-1;
      document.getElementById('pomo-round-label').textContent = `Round ${round}`;
      document.getElementById('pomo-phase-badge').textContent = 'Work';
      document.getElementById('pomo-phase-badge').className = 'pomo-phase-badge work';
      document.getElementById('pomo-bar-label').textContent = 'Work Session';
      document.getElementById('pomo-fill').className = 'completion-fill';
      document.getElementById('pomo-display').className = 'pomo-big-time running';
      orig = m.work*60000; rem = orig;
      document.getElementById('pomo-display').textContent = Fmt.mss(rem);
      document.getElementById('pomo-pct').textContent = '0%';
      document.getElementById('pomo-fill').style.width = '0%';
      Audio.phase(); renderDots();
      document.getElementById('pomo-total-rounds').textContent = (round-1) + ' rounds';
      startTs = Date.now();
      ticker.start();
    }
  };

  const renderDots = () => {
    document.getElementById('pomo-dots').innerHTML = Array.from({length:4},(_,i) =>
      `<div class="pomo-dot ${i<round-1?'done':i===round-1?'active':''}"></div>`).join('');
  };

  return {
    selectMode(idx) {
      mode = idx;
      document.querySelectorAll('.pomo-mode-card').forEach((c,i) => c.classList.toggle('active',i===idx));
      if (!run) this.reset();
    },
    reset() {
      ticker.stop(); run=false; phase='work'; round=1;
      const m = MODES[mode]; orig=m.work*60000; rem=orig; lastTick=-1;
      document.getElementById('pomo-display').textContent = Fmt.mss(rem);
      document.getElementById('pomo-display').className = 'pomo-big-time';
      document.getElementById('pomo-phase-badge').textContent = 'Work';
      document.getElementById('pomo-phase-badge').className = 'pomo-phase-badge work';
      document.getElementById('pomo-round-label').textContent = 'Round 1';
      document.getElementById('pomo-pct').textContent = '0%';
      document.getElementById('pomo-fill').style.width = '0%';
      document.getElementById('pomo-fill').className = 'completion-fill';
      document.getElementById('pomo-bar-label').textContent = 'Work Session';
      document.getElementById('pomo-btn-start').textContent = 'Start';
      document.getElementById('pomo-btn-start').classList.add('btn-primary');
      document.getElementById('pomo-btn-skip').disabled = true;
      document.getElementById('pomo-btn-reset').disabled = true;
      document.getElementById('pomo-card').classList.remove('running-glow');
      renderDots();
    },
    toggle() {
      Audio.ensure();
      if (!run) {
        startTs = Date.now()-(orig-rem); run=true; ticker.start();
        document.getElementById('pomo-display').classList.add(phase==='work'?'running':'rest-run');
        document.getElementById('pomo-card').classList.add('running-glow');
        document.getElementById('pomo-btn-start').textContent = 'Pause';
        document.getElementById('pomo-btn-start').classList.remove('btn-primary');
        document.getElementById('pomo-btn-skip').disabled = false;
        document.getElementById('pomo-btn-reset').disabled = false;
        Audio.start();
      } else {
        ticker.stop(); run=false;
        document.getElementById('pomo-display').className = 'pomo-big-time';
        document.getElementById('pomo-card').classList.remove('running-glow');
        document.getElementById('pomo-btn-start').textContent = 'Resume';
        document.getElementById('pomo-btn-start').classList.add('btn-primary');
        Audio.pause();
      }
    },
    skip() { ticker.stop(); rem=0; phaseEnd(); },
    renderHistory() {
      // Bug 3 fix: rebuild from session store so history survives page refresh
      const todayKey = Fmt.todayKey();
      const storedSessions = Store.sessions.load()
        .filter(s => s.date && s.date.slice(0,10) === todayKey && (s.type==='Pomodoro' || s.type==='Pomodoro Work'))
        .map(s => ({ round: 1, phase:'work', ms: s.ms, date: s.date }));
      // Merge with in-memory rounds (deduplicate by approximate timestamp within 2s)
      const inMem = rounds.filter(r => r.date.slice(0,10) === todayKey);
      const merged = [...storedSessions];
      inMem.forEach(r => {
        const rt = new Date(r.date).getTime();
        const dup = merged.some(m => Math.abs(new Date(m.date).getTime() - rt) < 2000);
        if (!dup) merged.push(r);
      });
      merged.sort((a,b) => new Date(a.date) - new Date(b.date));
      const workRounds = merged.filter(r => r.phase==='work');
      document.getElementById('pomo-today-count').textContent = workRounds.length;
      const el = document.getElementById('pomo-history');
      if (!merged.length) { el.innerHTML='<div class="empty-state">No rounds completed yet</div>'; return; }
      el.innerHTML = [...merged].reverse().map((r,i) => {
        const t = new Date(r.date).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
        const rn = workRounds.length - workRounds.findIndex(w=>w.date===r.date);
        return `<div class="session-item"><div class="session-left"><span class="session-type" style="color:${r.phase==='work'?'var(--teal)':'var(--gold)'}">${r.phase==='work'?'Work':'Rest'} · Round ${r.phase==='work'?rn:''}</span><span class="session-dur">${Fmt.dur(r.ms)}</span></div><span class="session-date">${t}</span></div>`;
      }).join('');
    }
  };
})();
function selectPomoMode(i){ Pomo.selectMode(i); }
function pomoToggle(){ Pomo.toggle(); }
function pomoSkip(){ Pomo.skip(); }
function pomoReset(){ Pomo.reset(); }

// ── MODULE: TASKS ─────────────────────────────────────────────────
const Tasks = (() => {
  let tasks=[], filter='all';
  let newType='stopwatch', newDur=0, newPri='low', newColor='none';
  const timers={}, pomoDots={};
  const expanded = new Set(); // which task cards have inline timer open
  const VIBGYOR = { none:'var(--teal2)',v:'#8B00FF',i:'#4B0082',b:'#1a6eff',g:'#00AA44',y:'#FFD700',o:'#FF8C00',r:'#FF2020' };
  const RING_R = 22, RING_CIRC = +(2 * Math.PI * 22).toFixed(2); // 138.23

  const load = () => { tasks = Store.tasks.load(); };
  const save = () => Store.tasks.save(tasks);

  const animateComplete = (id) => {
    const el = document.getElementById('task-item-'+id);
    if (!el) return;
    el.classList.add('completing');
    setTimeout(() => el.classList.remove('completing'), 500);
  };

  // ── Ring SVG helper ──
  const makeRingSVG = (id, pct, color, isStopwatch) => {
    const offset = isStopwatch
      ? RING_CIRC * (1 - (pct / 100))  // arc fills based on elapsed % of 60s cycle
      : RING_CIRC * (1 - (pct / 100));
    const stroke = isStopwatch ? color : (pct >= 80 ? 'var(--gold)' : color);
    const warnCls = (!isStopwatch && pct >= 80) ? ' warn' : '';
    return `<div class="task-ring-wrap">
      <svg class="task-ring-svg" width="52" height="52" viewBox="0 0 52 52">
        <circle class="task-ring-bg" cx="26" cy="26" r="${RING_R}" stroke-width="3"/>
        <circle class="task-ring-fill${warnCls}" cx="26" cy="26" r="${RING_R}" stroke-width="3"
          stroke="${stroke}" stroke-dasharray="${RING_CIRC.toFixed(2)}"
          stroke-dashoffset="${offset.toFixed(2)}" id="tk-ring-${id}"/>
      </svg>
      <div class="task-ring-center">
        <div class="task-ring-pct${warnCls}" id="tk-ring-pct-${id}">${isStopwatch ? '⏱' : pct + '%'}</div>
      </div>
    </div>`;
  };

  // ── updateLive: updates ring + inline timer display on every tick ──
  const updateLive = (id) => {
    const t = tasks.find(x => x.id===id); if (!t) return;
    const type = t.timerType || 'stopwatch';
    const isExp = expanded.has(id);

    // === Update ring ===
    const ringEl = document.getElementById('tk-ring-'+id);
    const ringPctEl = document.getElementById('tk-ring-pct-'+id);
    if (ringEl) {
      let pct = 0, isStopwatch = false, warnRing = false;
      if (type === 'stopwatch') {
        isStopwatch = true;
        pct = ((t.elapsed % 60000) / 60000) * 100;
        const offset = RING_CIRC * (1 - pct/100);
        ringEl.style.strokeDashoffset = offset.toFixed(2);
        if (ringPctEl) ringPctEl.textContent = '⏱';
      } else if (type === 'timer') {
        pct = t.dur > 0 ? Math.min(Math.round((t.elapsed/t.dur)*100), 100) : 0;
        warnRing = pct >= 80;
        const offset = RING_CIRC * (1 - pct/100);
        ringEl.style.strokeDashoffset = offset.toFixed(2);
        ringEl.className = 'task-ring-fill' + (warnRing ? ' warn' : '');
        if (ringPctEl) { ringPctEl.textContent = pct + '%'; ringPctEl.className = 'task-ring-pct' + (warnRing ? ' warn' : ''); }
      } else if (type === 'pomodoro') {
        const ps = pomoDots[id];
        if (ps) {
          pct = Math.round((1 - ps.rem/ps.orig)*100);
          const offset = RING_CIRC * (1 - pct/100);
          ringEl.style.strokeDashoffset = offset.toFixed(2);
          if (ringPctEl) ringPctEl.textContent = ps.phase === 'work' ? '🍅' : '☕';
        }
      }
    }

    // === Update inline timer if expanded ===
    if (isExp) {
      const titTime = document.getElementById('tit-time-'+id);
      const titSub = document.getElementById('tit-sub-'+id);
      const titPlay = document.getElementById('tit-play-'+id);
      const isRun = !!timers[id];
      if (!titTime) return;

      if (type === 'stopwatch') {
        titTime.textContent = Fmt.mss(t.elapsed||0);
        titTime.className = 'tit-time' + (isRun ? ' running' : '');
        if (titSub) titSub.textContent = 'Elapsed';
      } else if (type === 'timer') {
        const rem = Math.max(0, (t.dur||0) - (t.elapsed||0));
        const pct2 = t.dur > 0 ? Math.min(Math.round(((t.elapsed||0)/t.dur)*100),100) : 0;
        const warn2 = pct2 >= 80;
        titTime.textContent = Fmt.mss(rem);
        titTime.className = 'tit-time' + (isRun ? (warn2 ? ' warn' : ' running') : '');
        if (titSub) titSub.textContent = Fmt.mss(rem) + ' remaining';
        // update bar
        const titBar = titTime.parentElement.querySelector('.tit-progress-fill');
        if (titBar) { titBar.style.width = pct2 + '%'; titBar.className = 'tit-progress-fill' + (warn2 ? ' warn' : ''); }
      } else if (type === 'pomodoro') {
        const ps = pomoDots[id];
        if (ps) {
          titTime.textContent = Fmt.mss(ps.rem);
          titTime.className = 'tit-time' + (isRun ? ' running' : '');
          if (titSub) titSub.textContent = ps.phase === 'work' ? '🍅 Focus Time' : '☕ Break Time';
          const titBar = titTime.parentElement.querySelector('.tit-progress-fill');
          if (titBar) titBar.style.width = Math.round((1-ps.rem/ps.orig)*100) + '%';
        }
      }
      if (titPlay) titPlay.textContent = isRun ? '⏸ Pause' : '▶ Start';
    }
  };

  const startTimer = (id) => {
    const t = tasks.find(x => x.id===id); if (!t||t.done) return;
    const type = t.timerType||'stopwatch';
    // Expand card on start
    expanded.add(id);

    if (type==='stopwatch') {
      timers[id] = { type, start: Date.now()-(t.elapsed||0) };
      const tick = () => {
        if (!timers[id]) return;
        t.elapsed = Date.now()-timers[id].start;
        updateLive(id);
        timers[id]._timer = setTimeout(tick, 250);
      };
      timers[id]._timer = setTimeout(tick, 250);
    } else if (type==='timer') {
      // FIX: ensure dur is valid before starting
      if (!t.dur || t.dur <= 0) return;
      timers[id] = { type, start: Date.now()-(t.elapsed||0) };
      const tick = () => {
        if (!timers[id]) return;
        t.elapsed = Date.now()-timers[id].start;
        updateLive(id);
        if (t.elapsed >= t.dur) {
          stopTimer(id); t.done=true;
          animateComplete(id);
          Store.record('Task', t.elapsed, t.name, Mirror.getActiveId());
          save(); render(); Audio.taskDone(); return;
        }
        timers[id]._timer = setTimeout(tick, 250);
      };
      timers[id]._timer = setTimeout(tick, 250);
    } else if (type==='pomodoro') {
      const pd = 25*60000;
      if (!pomoDots[id]) pomoDots[id] = { round:1, phase:'work', rem:pd, orig:pd };
      const ps = pomoDots[id];
      timers[id] = { type, start: Date.now()-(ps.orig-ps.rem) };
      const tick = () => {
        if (!timers[id]) return;
        const el2 = Date.now()-timers[id].start;
        ps.rem = Math.max(0, ps.orig-el2);
        updateLive(id);
        if (ps.rem <= 0) {
          Audio.phase();
          if (ps.phase==='work') { ps.phase='rest'; ps.orig=5*60000; ps.rem=ps.orig; Store.record('Task Pomodoro',25*60000,t.name,Mirror.getActiveId()); }
          else { ps.phase='work'; ps.round++; ps.orig=25*60000; ps.rem=ps.orig; }
          timers[id].start = Date.now();
          // Re-render inline pomo phase badge
          const phBadge = document.querySelector(`#tit-${id} .tit-pomo-phase`);
          if (phBadge) { phBadge.className='tit-pomo-phase '+ps.phase; phBadge.innerHTML=(ps.phase==='work'?'🍅 Work':'☕ Rest')+`<span class="tit-pomo-rounds">R${ps.round}</span>`; }
        }
        timers[id]._timer = setTimeout(tick, 250);
      };
      timers[id]._timer = setTimeout(tick, 250);
    }
    renderItem(id); // re-render just this card to show expanded + play state
  };

  const stopTimer = (id) => {
    if (timers[id]) { clearTimeout(timers[id]._timer); delete timers[id]; }
    const t = tasks.find(x => x.id===id); if (t) save();
    renderItem(id);
  };

  // Re-render a single task item in place (avoids full list re-render flicker)
  const renderItem = (id) => {
    const t = tasks.find(x => x.id==id); if(!t) return;
    const el = document.getElementById('task-item-'+id); if (!el) { render(); return; }
    el.outerHTML = buildTaskHTML(t);
    updateLive(id);
  };

  const buildTaskHTML = (t) => {
    const isRun = !!timers[t.id];
    const isExp = expanded.has(t.id);
    const type = t.timerType||'stopwatch';
    const hasDur = type==='timer' && t.dur > 0;
    const pct = hasDur ? Math.min(Math.round(((t.elapsed||0)/t.dur)*100),100) : 0;
    const pomoPct = (type==='pomodoro' && pomoDots[t.id]) ? Math.round((1-pomoDots[t.id].rem/pomoDots[t.id].orig)*100) : 0;
    const ringPct = type==='pomodoro' ? pomoPct : pct;
    const hasC = t.color && t.color!=='none';
    const col = VIBGYOR[t.color||'none'];
    const isStopwatch = type==='stopwatch';
    const typeLbl = {stopwatch:'⏱ SW',timer:'⏳ TM',pomodoro:'🍅 PM'}[type]||'⏱ SW';

    // Ring offset
    let ringOffset = RING_CIRC.toFixed(2); // default: empty ring (no progress)
    if (isStopwatch) {
      ringOffset = (RING_CIRC * (1 - ((t.elapsed||0) % 60000) / 60000)).toFixed(2);
    } else {
      ringOffset = (RING_CIRC * (1 - ringPct/100)).toFixed(2);
    }
    const ringWarn = (!isStopwatch && ringPct >= 80);
    const ringPctTxt = isStopwatch ? '⏱' : (ringPct + '%');

    let clockTxt = '—';
    if (t.done && t.elapsed > 0) clockTxt = Fmt.mss(t.elapsed) + ' done';
    else if (type==='timer' && hasDur) clockTxt = Fmt.mss(Math.max(0,(t.dur||0)-(t.elapsed||0))) + ' left';
    else if (type==='pomodoro') { const ps=pomoDots[t.id]; clockTxt = ps ? (ps.phase==='work'?'🍅 ':'☕ ')+Fmt.mss(ps.rem) : '🍅 25:00'; }
    else if (t.elapsed > 0) clockTxt = Fmt.mss(t.elapsed);

    return `<div class="task-item${isRun?' running':''}${t.done?' done-task':''}${isExp?' expanded':''}" id="task-item-${t.id}" style="${hasC?'border-color:'+col+'22':''}">
      <div class="task-pri-bar ${hasC?'color-'+t.color:t.pri||'low'}"></div>
      <div class="task-item-inner">
        <div class="task-check${t.done?' checked':''}" onclick="Tasks.toggleDone(${t.id})"></div>
        <div class="task-info">
          <div class="task-name">${Fmt.escHtml(t.name)}</div>
          <div class="task-meta">
            <span class="task-type-badge" style="${hasC?'border-color:'+col+';color:'+col:''}">${typeLbl}</span>
            <span class="task-clock-display${t.done?' done-t':isRun?(ringWarn?' warn':' running'):''}" id="tk-clock-${t.id}">${clockTxt}</span>
          </div>
        </div>
        <div class="task-actions">
          ${!t.done ? `<button class="task-act play-btn" onclick="Tasks.expandAndToggle(${t.id})" title="${isRun?'Pause':'Start'}">${isRun?'⏸':'▶'}</button>` : ''}
          <button class="task-act del-btn" onclick="Tasks.delete(${t.id})">✕</button>
        </div>
        <div class="task-ring-wrap" id="tk-ring-wrap-${t.id}">
          <svg class="task-ring-svg" width="52" height="52" viewBox="0 0 52 52">
            <circle class="task-ring-bg" cx="26" cy="26" r="${RING_R}" stroke-width="3"/>
            <circle class="task-ring-fill${ringWarn?' warn':''}" cx="26" cy="26" r="${RING_R}" stroke-width="3"
              stroke="${hasC ? col : ringWarn ? 'var(--gold)' : 'var(--teal)'}"
              stroke-dasharray="${RING_CIRC.toFixed(2)}" stroke-dashoffset="${ringOffset}"
              id="tk-ring-${t.id}"/>
          </svg>
          <div class="task-ring-center">
            <div class="task-ring-pct${ringWarn?' warn':''}" id="tk-ring-pct-${t.id}">${ringPctTxt}</div>
          </div>
        </div>
      </div>
      ${!t.done && isExp ? makeInlineTimer(t) : ''}
    </div>`;
  };

  const makeInlineTimer = (t) => {
    const isRun = !!timers[t.id];
    const type = t.timerType || 'stopwatch';
    const hasDur = type==='timer' && t.dur > 0;
    const col = VIBGYOR[t.color||'none'];
    let timeStr = '00:00', subLabel = '', progPct = 0, warnCls = '', phaseBadge = '';

    if (type === 'stopwatch') {
      timeStr = Fmt.mss(t.elapsed || 0);
      subLabel = 'Elapsed';
    } else if (type === 'timer') {
      const rem = Math.max(0, (t.dur||0) - (t.elapsed||0));
      timeStr = Fmt.mss(rem);
      progPct = hasDur ? Math.min(Math.round(((t.elapsed||0)/t.dur)*100),100) : 0;
      subLabel = Fmt.mss(rem) + ' remaining';
      warnCls = progPct >= 80 ? ' warn' : '';
    } else if (type === 'pomodoro') {
      const ps = pomoDots[t.id];
      if (ps) {
        timeStr = Fmt.mss(ps.rem);
        progPct = Math.round((1 - ps.rem/ps.orig)*100);
        phaseBadge = `<div class="tit-pomo-phase ${ps.phase}">${ps.phase==='work'?'🍅 Work':'☕ Rest'}<span class="tit-pomo-rounds">R${ps.round}</span></div>`;
        subLabel = ps.phase === 'work' ? 'Focus Time' : 'Break Time';
      } else {
        timeStr = '25:00'; subLabel = 'Ready to start';
        phaseBadge = `<div class="tit-pomo-phase work">🍅 Work<span class="tit-pomo-rounds">R1</span></div>`;
        progPct = 0;
      }
    }

    const hasProgress = type !== 'stopwatch';
    const progressBar = hasProgress
      ? `<div class="tit-progress"><div class="tit-progress-fill${warnCls}" id="tit-bar-${t.id}" style="width:${progPct}%"></div></div>`
      : '';
    const resetBtn = (type !== 'stopwatch') ? `<button class="tit-btn danger" onclick="Tasks.resetInlineTimer(${t.id})">↺ Reset</button>` : '';

    return `<div class="task-inline-timer" id="tit-${t.id}">
      ${phaseBadge}
      <div class="tit-body">
        <div class="tit-info">
          <div class="tit-time${isRun?(warnCls?' warn':' running'):''}" id="tit-time-${t.id}">${timeStr}</div>
          <div class="tit-sublabel" id="tit-sub-${t.id}">${subLabel}</div>
          ${progressBar}
          <div class="tit-btn-row">
            <button class="tit-btn primary" id="tit-play-${t.id}" onclick="Tasks.toggleTimer(${t.id})">${isRun ? '⏸ Pause' : '▶ Start'}</button>
            <button class="tit-btn" onclick="Tasks.collapseTimer(${t.id})">↑ Collapse</button>
            ${resetBtn}
          </div>
        </div>
      </div>
    </div>`;
  };

  const render = () => {
    load();
    // Sync elapsed for running stopwatch timers
    Object.keys(timers).forEach(id => {
      const t=tasks.find(x=>x.id==id);
      if(t&&timers[id].type==='stopwatch') t.elapsed=Date.now()-timers[id].start;
    });
    const active=tasks.filter(t=>!t.done);
    document.getElementById('task-count').textContent=`${active.length} active`;
    let shown;
    if(filter==='all')shown=tasks;
    else if(filter==='active')shown=active;
    else if(filter==='running')shown=tasks.filter(t=>timers[t.id]);
    else shown=tasks.filter(t=>t.done);
    const priVal={high:3,med:2,low:1};
    shown=[...shown].sort((a,b)=>{const ar=timers[a.id]?1:0,br=timers[b.id]?1:0;if(ar!==br)return br-ar;return(priVal[b.pri]||1)-(priVal[a.pri]||1);});
    const list=document.getElementById('task-list');
    if(!shown.length){list.innerHTML='<div class="empty-state">No tasks here</div>';return;}
    list.innerHTML=shown.map(t=>buildTaskHTML(t)).join('');
    // After render, update live rings for running tasks
    Object.keys(timers).forEach(id=>updateLive(Number(id)));
  };

  return {
    toggleDone(id) {
      load();
      const t=tasks.find(x=>x.id===id); if(!t) return;
      if(timers[id]) stopTimer(id);
      t.done=!t.done;
      expanded.delete(id);
      if(t.done&&t.elapsed>1000) {
        animateComplete(id);
        Store.record('Task',t.elapsed,t.name,Mirror.getActiveId());
        Audio.taskDone();
      }
      save(); render();
    },
    delete(id) { stopTimer(id); expanded.delete(id); load(); tasks=tasks.filter(x=>x.id!==id); save(); render(); },
    // ▶ button on card header: expand + start
    expandAndToggle(id) {
      Audio.ensure();
      load();
      if (!expanded.has(id)) {
        expanded.add(id);
        if (!timers[id]) { startTimer(id); Audio.start(); }
        else renderItem(id);
      } else {
        if (timers[id]) { stopTimer(id); Audio.pause(); }
        else { startTimer(id); Audio.start(); }
      }
    },
    // Toggle from inline timer buttons
    toggleTimer(id) {
      Audio.ensure();
      load();
      if(timers[id]){ stopTimer(id); Audio.pause(); }
      else { startTimer(id); Audio.start(); }
    },
    collapseTimer(id) {
      expanded.delete(id);
      renderItem(id);
    },
    resetInlineTimer(id) {
      load();
      const t = tasks.find(x=>x.id===id); if(!t) return;
      if(timers[id]) stopTimer(id);
      t.elapsed = 0;
      // Reset pomo state
      if(pomoDots[id]) delete pomoDots[id];
      save();
      renderItem(id);
    },
    add() {
      const inp=document.getElementById('task-input');
      const name=inp.value.trim(); if(!name) return;
      load();
      tasks.unshift({ id:Date.now(),name,timerType:newType,dur:newType==='timer'?newDur*60000:0,elapsed:0,done:false,pri:newPri,color:newColor,created:new Date().toISOString() });
      save(); inp.value=''; Audio.start(); render();
    },
    setType(type,el) {
      newType=type;
      document.querySelectorAll('.task-type-pill').forEach(p=>p.classList.remove('sel')); el.classList.add('sel');
      document.getElementById('task-dur-row').style.display=(type==='timer')?'flex':'none';
    },
    setDur(min,el) { newDur=min; document.querySelectorAll('.task-dur-pill').forEach(p=>p.classList.remove('sel')); el.classList.add('sel'); },
    setPri(pri,el) { newPri=pri; document.querySelectorAll('.task-pri-pill').forEach(p=>p.classList.remove('sel-high','sel-med','sel-low')); el.classList.add('sel-'+pri); },
    setColor(c,el) { newColor=c; document.querySelectorAll('.task-color-dot').forEach(d=>d.classList.remove('sel')); el.classList.add('sel'); },
    setFilter(f,el) { filter=f; document.querySelectorAll('.task-filter-btn').forEach(b=>b.classList.remove('active')); el.classList.add('active'); render(); },
    render
  };
})();
// Expose for inline handlers
function addTask(){ Tasks.add(); }
function selType(t,el){ Tasks.setType(t,el); }
function selDur(m,el){ Tasks.setDur(m,el); }
function selPri(p,el){ Tasks.setPri(p,el); }
function selColor(c,el){ Tasks.setColor(c,el); }
function setFilter(f,el){ Tasks.setFilter(f,el); }
function toggleTaskDone(id){ Tasks.toggleDone(id); }
function deleteTask(id){ Tasks.delete(id); }
function toggleTaskTimer(id){ Tasks.toggleTimer(id); }


// ── MODULE: MIRROR TASKS ─────────────────────────────────────────
// Data shape: { tasks: [{id, name, type:'daily'|'weekly', dailyMs, weeklyHrs, minMs, created}] }
// minMs = daily non-negotiable minimum (per-task)
const MirrorTasks = (() => {
  const STORE_KEY = 'chronoblast_mirror_v6';
  let data = { tasks: [] };
  let formType = 'daily';
  let _dpTask = null, _dpSelDur = 0;

  const load = () => {
    try { data = JSON.parse(localStorage.getItem(STORE_KEY)) || { tasks: [] }; }
    catch(e) { data = { tasks: [] }; }
  };
  const save = () => localStorage.setItem(STORE_KEY, JSON.stringify(data));

  const todayKey = () => new Date().toISOString().slice(0,10);
  const weekStart = () => {
    const d = new Date(); d.setHours(0,0,0,0);
    d.setDate(d.getDate() - d.getDay()); return d;
  };
  const fmtDurShort = (ms) => {
    if (!ms) return '0m';
    const h = Math.floor(ms/3600000), m = Math.floor((ms%3600000)/60000), s = Math.floor((ms%60000)/1000);
    if (h && m) return `${h}h ${m}m`;
    if (h) return `${h}h`;
    if (m) return `${m}m`;
    return `${s}s`;
  };
  const fmtDate = (d) => d.toLocaleDateString('en-US',{month:'short',day:'numeric'});
  const getWeekRange = () => {
    const ws = weekStart(); const we = new Date(ws); we.setDate(we.getDate()+6);
    return fmtDate(ws) + ' – ' + fmtDate(we);
  };

  const getLogged = (taskId, period) => {
    const sessions = Store.sessions.load().filter(s => String(s.goalId) === 'mt_'+taskId);
    if (period === 'day') return sessions.filter(s => s.date.slice(0,10) === todayKey()).reduce((a,s)=>a+s.ms,0);
    const ws = weekStart();
    return sessions.filter(s => new Date(s.date) >= ws).reduce((a,s)=>a+s.ms,0);
  };
  const getWeekLogged = () => Store.sessions.load().filter(s=>new Date(s.date)>=weekStart()).reduce((a,s)=>a+s.ms,0);
  const getTodayLogged = () => Store.sessions.load().filter(s=>s.date.slice(0,10)===todayKey()).reduce((a,s)=>a+s.ms,0);

  const renderSummary = () => {
    load();
    document.getElementById('mr-sum-today').textContent = fmtDurShort(getTodayLogged());
    document.getElementById('mr-sum-week').textContent = fmtDurShort(getWeekLogged());
    const done = data.tasks.filter(t => {
      const logged = getLogged(t.id, t.type==='weekly'?'week':'day');
      const target = t.type==='weekly' ? (t.weeklyHrs||0)*3600000 : (t.dailyMs||0);
      return target>0 && logged>=target;
    }).length;
    document.getElementById('mr-sum-tasks').textContent = done+'/'+data.tasks.length;
    document.getElementById('mr-daily-date').textContent = new Date().toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'});
    document.getElementById('mr-week-range').textContent = getWeekRange();
  };

  const renderTask = (t) => {
    const isDW = t.type==='weekly';
    const period = isDW ? 'week' : 'day';
    const doneMs = getLogged(t.id, period);
    const targetMs = isDW ? (t.weeklyHrs||0)*3600000 : (t.dailyMs||0);
    const minMs = t.minMs || 0; // daily non-negotiable
    const pct = targetMs>0 ? Math.min(Math.round((doneMs/targetMs)*100),100) : 0;
    const minMet = minMs > 0 && doneMs >= minMs;
    const minPct = minMs > 0 ? Math.min(Math.round((doneMs/minMs)*100),100) : 0;

    // Status level
    const hoursLeft = period==='day'
      ? (86400000-(new Date().getHours()*3600+new Date().getMinutes()*60)*1000)/86400000
      : (7-new Date().getDay())/7;
    const needed = 1 - (targetMs>0?doneMs/targetMs:1);
    let level = pct>=100?'full':needed>hoursLeft*1.5?'danger':needed>hoursLeft*1.1?'warn':'ok';
    const fillCls = level==='danger'?'danger':level==='warn'?'warn':level==='full'?'full':'';
    const pctCls = level==='danger'?'danger':level==='warn'?'warn':level==='full'?'done-c':'';
    const caution = (level==='danger'||level==='warn') ?
      `<span class="mr-caution ${level==='warn'?'warn-c':''}"> ${level==='danger'?'⚠ Behind':'↗ Catch up'}</span>` : '';

    const typeLbl = isDW ? 'Weekly' : 'Daily';
    const dailyLine = isDW ? `<div class="mr-daily-info">Daily slice: <span>${fmtDurShort(Math.round((t.weeklyHrs||0)*3600000/7))}/day</span></div>` : '';
    const fullMet = pct >= 100;

    // Minimum bar (only shown if minMs > 0)
    const minBar = minMs > 0 ? `<div class="mr-min-row">
      <span class="mr-min-label">Min</span>
      <div class="mr-min-track"><div class="mr-min-fill${minMet?' met':''}" style="width:${minPct}%"></div></div>
      <span class="mr-min-val">${fmtDurShort(minMs)}${minMet?'  ✓':''}</span>
    </div>` : '';

    // Min not met badge
    const minBadge = (minMs > 0 && !minMet) ?
      `<span class="mr-caution min-c">⚡ ${fmtDurShort(Math.max(0,minMs-doneMs))} to min</span>` : '';

    return `<div class="mr-task-row${pct>=100?' mr-done':''}${(!minMet&&minMs>0&&doneMs>=minMs/2)?' mr-min-met':''}">
      <div class="mr-task-inner">
        <div class="mr-task-top">
          <div class="mr-task-left">
            <div class="mr-task-name">${Fmt.escHtml(t.name)} ${caution}${minBadge}</div>
            <div class="mr-task-meta">
              <span class="mr-type-tag ${isDW?'weekly':''}">${typeLbl}</span>
              <span style="font-size:0.54rem;color:var(--muted)">${isDW?'This Week':'Today'}</span>
            </div>
            ${dailyLine}
          </div>
          <div class="mr-task-right">
            <span class="mr-pct-badge ${pctCls}">${pct}%</span>
            <button class="mr-del-btn" onclick="MirrorTasks.del('${t.id}')">✕</button>
          </div>
        </div>
        <div class="mr-progress-area" style="padding:0 0 10px">
          <div class="mr-bar-track"><div class="mr-bar-fill ${fillCls}" style="width:${pct}%"></div></div>
          <div class="mr-time-row">
            <span class="mr-time-done">${fmtDurShort(doneMs)}</span>
            <span class="mr-time-target">/ ${fmtDurShort(targetMs)}</span>
          </div>
          ${minBar}
        </div>
      </div>
      <div class="mr-actions">
        <button class="mr-launch-btn${fullMet?' full-met':''}" onclick="MirrorTasks.openDurPicker('${t.id}')">
          ${fullMet ? '✦ Add More' : '▶ Start Session'}
        </button>
      </div>
    </div>`;
  };

  const renderList = () => {
    load();
    const dailyTasks = data.tasks.filter(t=>t.type==='daily');
    const weeklyTasks = data.tasks.filter(t=>t.type==='weekly');
    const dl = document.getElementById('mr-daily-list');
    dl.innerHTML = dailyTasks.length ? dailyTasks.map(renderTask).join('') : '<div class="empty-state">No daily tasks — add one above</div>';
    const wl = document.getElementById('mr-weekly-list');
    wl.innerHTML = weeklyTasks.length ? weeklyTasks.map(renderTask).join('') : '<div class="empty-state">No weekly goals — add one above</div>';
    renderSummary();
  };

  // Duration Picker Modal
  const DurPicker = {
    open(taskId) {
      load();
      _dpTask = data.tasks.find(t=>t.id===taskId); if(!_dpTask) return;
      if (_dpTask.type==='daily') _dpSelDur = _dpTask.dailyMs||0;
      else _dpSelDur = Math.round((_dpTask.weeklyHrs||0)*3600000/7);
      const taskName = Fmt.escHtml(_dpTask.name);
      const typeLabel = _dpTask.type==='weekly'?'Weekly Goal · Daily Slice':'Daily Task';
      const recMs = _dpSelDur;
      const recStr = fmtDurShort(recMs);
      const pills = [15,30,45,60,90,120].map(m=>
        `<span class="dur-pill${m*60000===recMs?' sel':''}" onclick="MirrorTasks.selDur(${m*60000},this)">${m<60?m+'m':(m/60)+'h'}</span>`
      ).join('');
      const html = `<div class="dur-modal-overlay" id="dur-modal-overlay" onclick="MirrorTasks.closeDur(event)">
        <div class="dur-modal" onclick="event.stopPropagation()">
          <div class="dur-modal-title">${typeLabel}</div>
          <div class="dur-modal-name">${taskName}</div>
          <div class="dur-modal-label">Session Duration</div>
          <div class="dur-pills" id="dur-pills">
            ${pills}
            <span class="dur-pill${!_dpSelDur||![15,30,45,60,90,120].some(m=>m*60000===recMs)?' sel':''}" onclick="MirrorTasks.selDur(${recMs},this)" id="dur-pill-rec">✓ Rec. ${recStr}</span>
          </div>
          <div class="dur-modal-label">Launch With</div>
          <div class="dur-modal-modes">
            <div class="dur-mode-btn" onclick="MirrorTasks.launch('timer')">
              <div class="dur-mode-icon">⏳</div>
              <div class="dur-mode-label">Timer</div>
              <div class="dur-mode-sub">Countdown</div>
            </div>
            <div class="dur-mode-btn" onclick="MirrorTasks.launch('pomodoro')">
              <div class="dur-mode-icon">🍅</div>
              <div class="dur-mode-label">Pomodoro</div>
              <div class="dur-mode-sub">25 min cycles</div>
            </div>
          </div>
          <button class="dur-cancel" onclick="MirrorTasks.closeDur()">Cancel</button>
        </div>
      </div>`;
      document.body.insertAdjacentHTML('beforeend', html);
    },
    close() { const m=document.getElementById('dur-modal-overlay'); if(m) m.remove(); }
  };

  return {
    toggleForm() {
      const f = document.getElementById('mirror-create-form');
      f.style.display = f.style.display==='none'?'block':'none';
      document.getElementById('mirror-form-toggle').textContent = f.style.display==='none'?'+ New Task':'✕ Close';
    },
    selType(type, el) {
      formType = type;
      document.querySelectorAll('#mirror-create-form .task-type-pill').forEach(p=>p.classList.remove('sel')); el.classList.add('sel');
      document.getElementById('mr-daily-fields').style.display = type==='daily'?'block':'none';
      document.getElementById('mr-weekly-fields').style.display = type==='weekly'?'block':'none';
    },
    create() {
      load();
      const name = document.getElementById('mr-task-name').value.trim();
      if (!name) return;
      if (formType==='daily') {
        const h=parseInt(document.getElementById('mr-daily-h').value)||0;
        const m=parseInt(document.getElementById('mr-daily-m').value)||0;
        const s=parseInt(document.getElementById('mr-daily-s').value)||0;
        const ms=(h*3600+m*60+s)*1000;
        if (!ms) return;
        const mh=parseInt(document.getElementById('mr-min-h').value)||0;
        const mm=parseInt(document.getElementById('mr-min-m').value)||0;
        const ms2=parseInt(document.getElementById('mr-min-s').value)||0;
        const minMs=(mh*3600+mm*60+ms2)*1000;
        data.tasks.push({ id: String(Date.now()), name, type:'daily', dailyMs:ms, minMs:minMs||0, created:new Date().toISOString() });
      } else {
        const hrs = parseFloat(document.getElementById('mr-weekly-hrs').value)||0;
        if (!hrs) return;
        const mh=parseInt(document.getElementById('mr-wmin-h').value)||0;
        const mm=parseInt(document.getElementById('mr-wmin-m').value)||0;
        const minMs=(mh*3600+mm*60)*1000;
        data.tasks.push({ id: String(Date.now()), name, type:'weekly', weeklyHrs:hrs, minMs:minMs||0, created:new Date().toISOString() });
      }
      save();
      // Clear fields
