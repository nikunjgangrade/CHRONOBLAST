  font-family: 'Space Mono', monospace;
  font-size: 0.44rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--teal);
  opacity: 0;
  transition: opacity 0.3s ease;
}
.np-saved-flash.show { opacity: 1; }

/* Smooth tab separator between notepad-tabs and pane */
.notepad-tab-sep {
  height: 1px;
  background: var(--border);
  margin: 0 0 0 0;
  flex-shrink: 0;
  transition: background 0.35s ease;
}
[data-theme="light"] .notepad-tab-sep { background: rgba(0,0,0,0.08); }

/* Empty state in checklist/quotes */
.np-empty {
  text-align: center;
  padding: 28px 0;
  font-size: 0.6rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--muted2);
}
</style>

<div class="pwa-banner" id="pwa-banner">
  <div class="pwa-banner-icon">⏱</div>
  <div class="pwa-banner-body">
    <div class="pwa-banner-title" id="pwa-banner-title">Install ChronoBlast</div>
    <div class="pwa-banner-sub" id="pwa-banner-sub">Add to your home screen for instant access, offline use, and a full-screen experience.</div>
    <div class="pwa-banner-btns">
      <button class="pwa-install-btn" id="pwa-install-btn" onclick="PWABanner.action()">Install App</button>
      <button class="pwa-dismiss-btn" onclick="PWABanner.hide()">Not now</button>
    </div>
  </div>
</div>

<script>
const PWABanner = (() => {
  const el    = () => document.getElementById('pwa-banner');
  const title = () => document.getElementById('pwa-banner-title');
  const sub   = () => document.getElementById('pwa-banner-sub');
  const btn   = () => document.getElementById('pwa-install-btn');
  let _mode = 'install'; // 'install' | 'update'

  return {
    showInstall() {
      // Don't show if already installed as PWA
      if (document.documentElement.classList.contains('pwa-standalone')) return;
      // Don't re-show if dismissed this session
      try { if (sessionStorage.getItem('cb_pwa_dismissed')) return; } catch(e) {}
      _mode = 'install';
      title().textContent = 'Install ChronoBlast';
      sub().textContent   = 'Add to your home screen for instant access, offline use, and a full-screen experience.';
      btn().textContent   = '⬇ Install App';
      el().classList.add('show');
    },
    showUpdate() {
      _mode = 'update';
      title().textContent = 'Update available';
      sub().textContent   = 'A new version of ChronoBlast is ready. Reload to apply it.';
      btn().textContent   = '↻ Reload';
      el().classList.add('show');
    },
    hide() {
      el().classList.remove('show');
      try { sessionStorage.setItem('cb_pwa_dismissed', '1'); } catch(e) {}
    },
    action() {
      if (_mode === 'update') {
        // Tell SW to skip waiting, controllerchange will trigger reload
        navigator.serviceWorker.controller?.postMessage('skipWaiting');
      } else {
        window.PWAInstall?.trigger();
      }
    }
  };
})();
</script>

