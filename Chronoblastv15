<!-- ══ PWA: MANIFEST + SERVICE WORKER ══════════════════════════════
     Fully self-contained — no external files needed.
     Manifest is injected as a Blob URL data URI.
     Service Worker is registered from a Blob URL.
     Works when the file is served from any HTTP origin.
  ═══════════════════════════════════════════════════════════════════ -->
<script>
(function() {

  // ── 1. WEB APP MANIFEST ─────────────────────────────────────────
  // Describes the app to the browser so it can be "installed"
  const MANIFEST = {
    name: "ChronoBlast",
    short_name: "ChronoBlast",
    description: "Focus · Track · Measure — your all-in-one productivity timer",
    start_url: "./",
    display: "standalone",
    background_color: "#06080d",
    theme_color: "#06080d",
    orientation: "portrait-primary",
    categories: ["productivity", "utilities"],
    icons: [
      {
        src: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 192 192'%3E%3Crect width='192' height='192' rx='40' fill='%2306080d'/%3E%3Ccircle cx='96' cy='112' r='60' stroke='%2300e6c8' stroke-width='10' fill='none'/%3E%3Cpath d='M96 78v34l22 13' stroke='%2300e6c8' stroke-width='10' stroke-linecap='round'/%3E%3Cpath d='M72 20h48M96 20v20' stroke='%2300e6c8' stroke-width='10' stroke-linecap='round'/%3E%3C/svg%3E",
        sizes: "192x192",
        type: "image/svg+xml",
        purpose: "any maskable"
      },
      {
        src: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'%3E%3Crect width='512' height='512' rx='100' fill='%2306080d'/%3E%3Ccircle cx='256' cy='296' r='160' stroke='%2300e6c8' stroke-width='24' fill='none'/%3E%3Cpath d='M256 200v96l58 35' stroke='%2300e6c8' stroke-width='24' stroke-linecap='round'/%3E%3Cpath d='M192 52h128M256 52v52' stroke='%2300e6c8' stroke-width='24' stroke-linecap='round'/%3E%3C/svg%3E",
        sizes: "512x512",
        type: "image/svg+xml",
        purpose: "any maskable"
      }
    ],
    shortcuts: [
      { name: "Stopwatch",  short_name: "Watch", url: "./#sw", description: "Jump to stopwatch" },
      { name: "Timer",      short_name: "Timer", url: "./#tm", description: "Jump to timer" },
      { name: "Pomodoro",   short_name: "Pomo",  url: "./#pm", description: "Jump to pomodoro" }
    ]
  };

  const manifestBlob = new Blob([JSON.stringify(MANIFEST)], { type: 'application/json' });
  const manifestURL  = URL.createObjectURL(manifestBlob);
  document.getElementById('pwa-manifest').href = manifestURL;

  // ── 2. SERVICE WORKER ───────────────────────────────────────────
  // SW registration requires an http/https origin — it cannot run from
  // file:// or blob: URLs. We detect the protocol and skip gracefully,
  // showing a hosting hint instead.
  // ── 2. SERVICE WORKER ───────────────────────────────────────────
  // Registers sw.js from the same directory — works on any HTTP/HTTPS host.
  // On GitHub Pages: https://nikunjgangrade.github.io/CHRONOBLAST/sw.js
  if ('serviceWorker' in navigator && location.protocol.startsWith('http')) {
    // Resolve sw.js relative to this HTML file's location
    const swPath = new URL('sw.js', location.href).pathname;

    navigator.serviceWorker.register(swPath)
      .then(reg => {
        console.log('[ChronoBlast] SW registered ✓', reg.scope);
        reg.addEventListener('updatefound', () => {
          const sw = reg.installing;
          sw.addEventListener('statechange', () => {
            if (sw.state === 'installed' && navigator.serviceWorker.controller) {
              PWABanner.showUpdate();
            }
          });
        });
      })
      .catch(err => {
        // Silently fail — app still works without SW, just no offline cache
        console.info('[ChronoBlast] SW not available:', err.message);
      });

    let refreshing = false;
    navigator.serviceWorker.addEventListener('controllerchange', () => {
      if (!refreshing) { refreshing = true; location.reload(); }
    });
  } else if (location.protocol === 'file:') {
    console.info('[ChronoBlast] Open via HTTP/HTTPS to enable offline caching. Try: npx serve .');
  }

  // ── 3. INSTALL PROMPT ───────────────────────────────────────────
  // Capture the browser's native install prompt and surface it as a
  // clean in-app banner rather than the default browser UI.
  let _deferredPrompt = null;

  window.addEventListener('beforeinstallprompt', e => {
    e.preventDefault();
    _deferredPrompt = e;
    PWABanner.showInstall();
  });

  window.addEventListener('appinstalled', () => {
    _deferredPrompt = null;
    PWABanner.hide();
    console.log('[ChronoBlast] App installed!');
  });

  // ── 4. THEME COLOR SYNC ─────────────────────────────────────────
  // Keep the OS chrome color in sync with light/dark mode.
  const syncThemeColor = () => {
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    const color = isLight ? '#f0f4f8' : '#06080d';
    const meta = document.getElementById('meta-theme-color');
    if (meta) meta.setAttribute('content', color);
  };
  // Observe theme attribute changes
  new MutationObserver(syncThemeColor)
    .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  syncThemeColor();

  // ── 5. STANDALONE DETECTION ─────────────────────────────────────
  // Add a class when running as installed PWA (no browser chrome)
  const isStandalone = window.matchMedia('(display-mode: standalone)').matches
    || window.navigator.standalone === true;
  if (isStandalone) {
    document.documentElement.classList.add('pwa-standalone');
    console.log('[ChronoBlast] Running as installed PWA');
  }

  // Expose install trigger for banner buttons
  window.PWAInstall = {
    trigger() {
      if (!_deferredPrompt) return;
      _deferredPrompt.prompt();
      _deferredPrompt.userChoice.then(choice => {
        _deferredPrompt = null;
        PWABanner.hide();
      });
    },
    isAvailable() { return !!_deferredPrompt; }
  };

})();
</script>

