  if (ev.key === 'Escape') closeExportModal();
}

function runExport(range) {
  try {
    const payload = buildExportPayload(range);
    const stamp = new Date().toISOString().slice(0,10);
    const fname = `chronoblast-${range}-stats-${stamp}.json`;
    const blob = new Blob([JSON.stringify(payload, null, 2)], {type:'application/json'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = fname;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1500);
    closeExportModal();
  } catch (err) {
    console.error('Export failed', err);
    alert('Export failed: ' + (err && err.message ? err.message : 'unknown error'));
  }
}

// Builds the detailed statistics payload for the selected range.
function buildExportPayload(range) {
  const all = Store.sessions.load() || [];
  const now = new Date();
  let start, end = new Date(now), label;

  if (range === 'week') {
    start = new Date(now); start.setDate(start.getDate() - 6); start.setHours(0,0,0,0);
    label = 'Last 7 days';
  } else if (range === 'month') {
    start = new Date(now); start.setDate(start.getDate() - 29); start.setHours(0,0,0,0);
    label = 'Last 30 days';
  } else {
    start = null; label = 'Lifetime';
  }

  const inRange = start
    ? all.filter(s => { const t = new Date(s.date); return t >= start && t <= end; })
    : all.slice();

  // ── Aggregates ──
  const totalMs   = inRange.reduce((a,s)=>a + (s.ms||0), 0);
  const count     = inRange.length;
  const avgMs     = count ? Math.round(totalMs / count) : 0;
  const longestMs = count ? Math.max(...inRange.map(s=>s.ms||0)) : 0;
  const shortestMs= count ? Math.min(...inRange.map(s=>s.ms||0)) : 0;

  // Per-day breakdown
  const byDay = {};
  inRange.forEach(s => {
    const k = (s.date||'').slice(0,10);
    if (!k) return;
    if (!byDay[k]) byDay[k] = { date:k, ms:0, sessions:0 };
    byDay[k].ms += s.ms||0;
    byDay[k].sessions += 1;
  });
  const dailyBreakdown = Object.values(byDay).sort((a,b)=>a.date.localeCompare(b.date))
    .map(d => ({ date: d.date, focusMs: d.ms, focusReadable: humanDur(d.ms), sessions: d.sessions }));
  const activeDays = dailyBreakdown.length;

  // Per-type breakdown (Stopwatch, Timer, Pomodoro, Mirror Goal, etc.)
  const byType = {};
  inRange.forEach(s => {
    const t = s.type || 'Unknown';
    if (!byType[t]) byType[t] = { type:t, ms:0, sessions:0 };
    byType[t].ms += s.ms||0;
    byType[t].sessions += 1;
  });
  const typeBreakdown = Object.values(byType).sort((a,b)=>b.ms-a.ms)
    .map(t => ({ type:t.type, focusMs:t.ms, focusReadable: humanDur(t.ms), sessions:t.sessions,
                 share: totalMs ? +(t.ms/totalMs*100).toFixed(1) : 0 }));

  // Per-task breakdown
  const byTask = {};
  inRange.filter(s => s.taskName).forEach(s => {
    const n = s.taskName;
    if (!byTask[n]) byTask[n] = { name:n, ms:0, sessions:0 };
    byTask[n].ms += s.ms||0;
    byTask[n].sessions += 1;
  });
  const taskBreakdown = Object.values(byTask).sort((a,b)=>b.ms-a.ms)
    .map(t => ({ task:t.name, focusMs:t.ms, focusReadable: humanDur(t.ms), sessions:t.sessions,
                 share: totalMs ? +(t.ms/totalMs*100).toFixed(1) : 0 }));

  // Hour-of-day heatmap (24 buckets)
  const hourMap = Array(24).fill(0);
  inRange.forEach(s => {
    const h = (typeof s.hour === 'number') ? s.hour : new Date(s.date).getHours();
    if (h >= 0 && h < 24) hourMap[h] += s.ms||0;
  });
  const hourly = hourMap.map((ms,h) => ({ hour:h, focusMs:ms, focusReadable: humanDur(ms) }));
  const peakHourEntry = hourly.slice().sort((a,b)=>b.focusMs-a.focusMs)[0];
  const peakHour = peakHourEntry && peakHourEntry.focusMs > 0
    ? String(peakHourEntry.hour).padStart(2,'0') + ':00'
    : null;

  // Weekday distribution (Sun-Sat)
  const dayNames = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  const weekdayMs = Array(7).fill(0);
  const weekdayCt = Array(7).fill(0);
  inRange.forEach(s => {
    const d = new Date(s.date).getDay();
    weekdayMs[d] += s.ms||0;
    weekdayCt[d] += 1;
  });
  const weekdayBreakdown = dayNames.map((n,i) => ({
    weekday:n, focusMs:weekdayMs[i], focusReadable:humanDur(weekdayMs[i]), sessions:weekdayCt[i]
  }));

  // Streak (all-time, regardless of selected range — meaningful metric)
  const streakDays = computeStreak(all);

  // Focus score (today, snapshot)
  const focusScoreToday = computeFocusScore(all);

  // Goal progress baseline (same goals used in UI)
  const goalMs = range==='week' ? 20*3600000 : range==='month' ? 80*3600000 : 500*3600000;
  const goalProgressPct = goalMs ? Math.min(100, +(totalMs/goalMs*100).toFixed(1)) : 0;

  // Sleek, well-organised payload
  return {
    app: 'ChronoBlast',
    schemaVersion: 2,
    exportedAt: new Date().toISOString(),
    range: {
      key: range,
      label: label,
      from: start ? start.toISOString() : null,
      to: end.toISOString()
    },
    summary: {
      totalFocusMs:   totalMs,
      totalFocusReadable: humanDur(totalMs),
      sessions: count,
      activeDays: activeDays,
      avgSessionMs:  avgMs,
      avgSessionReadable: humanDur(avgMs),
      longestSessionMs:  longestMs,
      longestSessionReadable: humanDur(longestMs),
      shortestSessionMs: shortestMs,
      shortestSessionReadable: humanDur(shortestMs),
      peakHour: peakHour,
      streakDays: streakDays,
      focusScoreToday: focusScoreToday,
      goalMs: goalMs,
      goalReadable: humanDur(goalMs),
      goalProgressPct: goalProgressPct
    },
    dailyBreakdown,
    weekdayBreakdown,
    hourly,
    typeBreakdown,
    taskBreakdown,
    sessions: inRange.map(s => ({
      date: s.date,
      type: s.type,
      taskName: s.taskName || null,
      goalId: s.goalId || null,
      ms: s.ms,
      readable: humanDur(s.ms),
      hour: (typeof s.hour === 'number') ? s.hour : new Date(s.date).getHours()
    })),
    profile: Store.profile.load() || null
  };

  // ── helpers (closure-local) ──
  function humanDur(ms) {
    ms = Math.max(0, Math.round(ms||0));
    const s = Math.floor(ms/1000), h = Math.floor(s/3600),
          m = Math.floor((s%3600)/60), sec = s%60;
    if (h > 0) return `${h}h ${m}m`;
    if (m > 0) return `${m}m ${sec}s`;
    return `${sec}s`;
  }
  function computeStreak(sessions) {
    if (!sessions || !sessions.length) return 0;
    const days = new Set(sessions.map(x => (x.date||'').slice(0,10)));
    let streak = 0; const d = new Date();
    while (true) {
      const k = d.toISOString().slice(0,10);
      if (days.has(k)) { streak++; d.setDate(d.getDate()-1); } else break;
    }
    return streak;
  }
  function computeFocusScore(sessions) {
    if (!sessions || !sessions.length) return 0;
    const todayKey = new Date().toISOString().slice(0,10);
    const today = sessions.filter(x => (x.date||'').slice(0,10) === todayKey);
    const todayMs = today.reduce((a,s)=>a+(s.ms||0),0);
    const streak = computeStreak(sessions);
    return Math.min(100, Math.round(
      Math.min(today.length*8, 40) +
      Math.min(todayMs/3600000*10, 40) +
      Math.min(streak*4, 20)
    ));
  }
}


// ── AUTO CREDIT + CONFIRMATION TOAST ────────────────────────────
const CreditToast = (() => {
  let _lastGoalId=null, _lastMs=0, _undone=false, _toastTimer=null;

  const fmtDur = (ms) => {
    const s=Math.floor(ms/1000),h=Math.floor(s/3600),m=Math.floor((s%3600)/60),sc=s%60;
    return (h?h+'h ':'')+m+'m '+(sc?sc+'s':'');
  };

  const resolveGoalName = (goalId) => {
    // Try MirrorTasks first (new system — prefix 'mt_')
    if (goalId && String(goalId).startsWith('mt_')) {
      try {
        const d = JSON.parse(localStorage.getItem('chronoblast_mirror_v6'))||{tasks:[]};
        const tid = String(goalId).replace('mt_','');
        const t = d.tasks.find(x=>x.id===tid);
        if (t) return t.name;
      } catch(e){}
    }
    // Fallback: old mirror store
    try {
      const mirrorData = Store.mirror.load();
      const allGoals = [...(mirrorData.goals||[]), ...(mirrorData.dailyGoals||[]).map(g=>({...g,id:'d_'+g.id}))];
      const g = allGoals.find(g=>String(g.id)===String(goalId));
      if (g) return g.name;
    } catch(e){}
    return 'Active Goal';
  };

  const _showToast = (goalName, ms) => {
    document.getElementById('ct-goal-name').textContent = goalName;
    document.getElementById('ct-session-dur').textContent = 'Credited: ' + fmtDur(ms);
    document.getElementById('ct-title').textContent = '✦ Session credited';
    document.getElementById('ct-yes-btn').style.display = 'none';
    document.getElementById('ct-undo-btn').style.display = '';
    const t = document.getElementById('credit-toast');
    t.classList.add('show');
    if (_toastTimer) clearTimeout(_toastTimer);
    _toastTimer = setTimeout(() => obj.hide(), 7000);
  };

  const obj = {
    showConfirmed(goalId, ms) {
      _undone = false; _lastGoalId = goalId; _lastMs = ms;
      _showToast(resolveGoalName(goalId), ms);
      MirrorTasks.render();
    },
    autoCredit(goalId, goalName, ms) {
      _undone = false; _lastGoalId = goalId; _lastMs = ms;
      Store.record('Mirror Goal', ms, '', goalId);
      MirrorTasks.render();
      _showToast(goalName || resolveGoalName(goalId), ms);
    },
    hide() {
      if (_toastTimer) { clearTimeout(_toastTimer); _toastTimer = null; }
      document.getElementById('credit-toast').classList.remove('show');
      _lastGoalId = null; _lastMs = 0;
    },
    undo() {
      if (!_lastGoalId || _undone) return;
      _undone = true;
      const sessions = Store.sessions.load();
      const idx = sessions.findIndex(s => String(s.goalId)===String(_lastGoalId) && s.ms===_lastMs);
      if (idx !== -1) sessions.splice(idx, 1);
      Store.sessions.save(sessions);
      MirrorTasks.render();
      obj.hide();
    },
    confirm() { obj.hide(); }
  };
  return obj;
})();
function creditConfirm(yes){ CreditToast.confirm(yes); }
function creditUndo(){ CreditToast.undo(); }

