<script>
// ══════════════════════════════════════════════════════════════
// NOTEPAD MODULE — ChronoBlast V14
// Panes: Notes (freeform) | Checklist | Quotes
// Persists to localStorage. Theme-aware. Zero dependencies.
// ══════════════════════════════════════════════════════════════
const NP = (() => {
  const STORE_KEY = 'cb_notepad_v1';
  let _data = { note: '', checks: [], quotes: [], pane: 'notes' };
  let _saveTimer = null;

  // ── Storage ──────────────────────────────────────────────────
  const load = () => {
    try {
      const raw = localStorage.getItem(STORE_KEY);
      if (raw) _data = { ..._data, ...JSON.parse(raw) };
    } catch(e) {}
  };

  const save = () => {
    try { localStorage.setItem(STORE_KEY, JSON.stringify(_data)); } catch(e) {}
    // Flash "Saved" briefly
    const fl = document.getElementById('np-note-saved');
    if (fl) { fl.classList.add('show'); clearTimeout(fl._t); fl._t = setTimeout(() => fl.classList.remove('show'), 1400); }
  };

  const debounceSave = () => {
    clearTimeout(_saveTimer);
    _saveTimer = setTimeout(save, 600);
  };

  // ── Init ─────────────────────────────────────────────────────
  const init = () => {
    load();
    const ta = document.getElementById('np-textarea');
    if (ta) { ta.value = _data.note || ''; updateCharCount(); }
    renderChecklist();
    renderQuotes();
    switchPane(_data.pane || 'notes', null, true);
  };

  // ── Char count ───────────────────────────────────────────────
  const updateCharCount = () => {
    const ta = document.getElementById('np-textarea');
    const cc = document.getElementById('np-char-count');
    if (!ta || !cc) return;
    const len = ta.value.length;
    cc.textContent = len.toLocaleString() + ' char' + (len !== 1 ? 's' : '');
    cc.className = 'np-char-count' + (len > 4500 ? ' near' : '');
  };

  // ── Notes pane ───────────────────────────────────────────────
  const onType = () => {
    const ta = document.getElementById('np-textarea');
    if (ta) _data.note = ta.value;
    updateCharCount();
    debounceSave();
  };

  const copyNote = () => {
    const ta = document.getElementById('np-textarea');
    if (!ta || !ta.value.trim()) return;
    try {
      navigator.clipboard.writeText(ta.value).then(() => {
        const btn = document.querySelector('.np-action-btn');
        if (btn) { const orig = btn.textContent; btn.textContent = 'Copied ✓'; setTimeout(() => btn.textContent = orig, 1500); }
      });
    } catch(e) {
      ta.select(); document.execCommand('copy');
    }
  };

  const clearNote = () => {
    if (!confirm('Clear the notepad? This cannot be undone.')) return;
    const ta = document.getElementById('np-textarea');
    if (ta) ta.value = '';
    _data.note = '';
    updateCharCount();
    save();
  };

  // ── Checklist pane ───────────────────────────────────────────
  const renderChecklist = () => {
    const el = document.getElementById('np-checklist');
    if (!el) return;
    // Update count badge
    const cc = document.getElementById('np-check-count');
    if (cc) {
      const done = _data.checks.filter(c => c.done).length;
      cc.textContent = `${_data.checks.length} item${_data.checks.length !== 1 ? 's' : ''}${done ? ' · ' + done + ' done' : ''}`;
    }
    if (!_data.checks.length) {
      el.innerHTML = '<div class="np-empty">No items yet</div>';
      return;
    }
    el.innerHTML = _data.checks.map((item, i) => `
      <div class="notepad-check-item${item.done ? ' checked' : ''}" id="np-ci-${i}">
        <div class="np-check${item.done ? ' checked' : ''}" onclick="NP.toggleCheck(${i})">${item.done ? '✓' : ''}</div>
        <span class="np-check-text" contenteditable="true" spellcheck="false"
          onblur="NP.updateCheckText(${i},this.textContent)"
          onkeydown="if(event.key==='Enter'){event.preventDefault();this.blur();}">${escHtml(item.text)}</span>
        <button class="np-del" onclick="NP.deleteCheck(${i})">✕</button>
      </div>`).join('');
  };

  const addCheckItem = () => {
    const inp = document.getElementById('np-check-input');
    const text = inp ? inp.value.trim() : '';
    if (!text) return;
    _data.checks.push({ text, done: false });
    inp.value = '';
    save();
    renderChecklist();
    // Scroll to bottom
    setTimeout(() => {
      const cl = document.getElementById('np-checklist');
      if (cl) cl.scrollTop = cl.scrollHeight;
    }, 60);
  };

  const toggleCheck = (i) => {
    if (!_data.checks[i]) return;
    _data.checks[i].done = !_data.checks[i].done;
    save();
    renderChecklist();
  };

  const updateCheckText = (i, text) => {
    if (!_data.checks[i]) return;
    const trimmed = text.trim();
    if (!trimmed) { deleteCheck(i); return; }
    _data.checks[i].text = trimmed;
    debounceSave();
  };

  const deleteCheck = (i) => {
    _data.checks.splice(i, 1);
    save();
    renderChecklist();
  };

  const clearChecked = () => {
    _data.checks = _data.checks.filter(c => !c.done);
    save();
    renderChecklist();
  };

  // ── Quotes pane ──────────────────────────────────────────────
  const renderQuotes = () => {
    const el = document.getElementById('np-quotes-list');
    if (!el) return;
    if (!_data.quotes.length) {
      el.innerHTML = '<div class="np-empty">No quotes yet</div>';
      return;
    }
    el.innerHTML = _data.quotes.map((q, i) => `
      <div class="np-quote-item">
        <div class="np-quote-text">"${escHtml(q.text)}"</div>
        ${q.author ? `<div class="np-quote-author">— ${escHtml(q.author)}</div>` : ''}
        <button class="np-quote-del" onclick="NP.deleteQuote(${i})">✕</button>
      </div>`).join('');
  };

  const addQuote = () => {
    const textEl = document.getElementById('np-quote-text');
    const authEl = document.getElementById('np-quote-author');
    const text = textEl ? textEl.value.trim() : '';
    if (!text) return;
    const author = authEl ? authEl.value.trim() : '';
    _data.quotes.unshift({ text, author });
    textEl.value = ''; if (authEl) authEl.value = '';
    save();
    renderQuotes();
  };

  const deleteQuote = (i) => {
    _data.quotes.splice(i, 1);
    save();
    renderQuotes();
  };

  // ── Pane switching ───────────────────────────────────────────
  const switchPane = (pane, btn, silent) => {
    _data.pane = pane;
    if (!silent) debounceSave();
    // Update tab buttons
    document.querySelectorAll('.notepad-tab').forEach(t => t.classList.remove('active'));
    const activeTab = document.getElementById('np-tab-' + pane);
    if (activeTab) activeTab.classList.add('active');
    // Show correct pane
    document.querySelectorAll('.notepad-pane').forEach(p => p.classList.remove('active'));
    const activePane = document.getElementById('np-pane-' + pane);
    if (activePane) activePane.classList.add('active');
  };

  // ── Mobile open/close ────────────────────────────────────────
  const openMobile = () => {
    const sidebar = document.getElementById('notepad-sidebar');
    if (sidebar) sidebar.classList.add('mobile-open');
    document.body.style.overflow = 'hidden';
  };

  const closeMobile = () => {
    const sidebar = document.getElementById('notepad-sidebar');
    if (sidebar) sidebar.classList.remove('mobile-open');
    document.body.style.overflow = '';
  };

  // ── Helpers ──────────────────────────────────────────────────
  const escHtml = s => String(s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;');

  // ── Public API ───────────────────────────────────────────────
  return {
    init, onType, copyNote, clearNote,
    addCheckItem, toggleCheck, updateCheckText, deleteCheck, clearChecked,
    addQuote, deleteQuote,
    switchPane: (p, el) => switchPane(p, el),
    openMobile, closeMobile,
  };
})();

// Initialise notepad after DOM is ready
document.addEventListener('DOMContentLoaded', () => NP.init(), { once: true });
// Fallback if DOMContentLoaded already fired
if (document.readyState !== 'loading') NP.init();
</script>

