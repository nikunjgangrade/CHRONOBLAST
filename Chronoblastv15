// ── MODULE: STATISTICS ────────────────────────────────────────────
const Stats = (() => {
  let report = 'day';

  const getStreak = (sessions) => {
    if (!sessions.length) return 0;
    const days = new Set(sessions.map(s=>s.date.slice(0,10)));
    let streak=0; const d=new Date();
    while(true){const k=d.toISOString().slice(0,10);if(days.has(k)){streak++;d.setDate(d.getDate()-1);}else break;}
    return streak;
  };

  const calcFocusScore = (sessions) => {
    if (!sessions.length) return 0;
    const streak = getStreak(sessions);
    const today = sessions.filter(s=>s.date.slice(0,10)===Fmt.todayKey());
    const todayMs = today.reduce((a,s)=>a+s.ms,0);
    return Math.min(Math.round(Math.min(today.length*8,40)+Math.min(todayMs/3600000*10,40)+Math.min(streak*4,20)),100);
  };

  return {
    switchReport(period) {
      report = period;
      document.querySelectorAll('.report-tab').forEach((b,i)=>b.classList.toggle('active',['day','week','month','life'][i]===period));
      this.renderReport();
    },
    renderReport() {
      const sessions=Store.sessions.load(); const now=new Date();
      let filtered=[],label='',goal=8*3600000;
      if(report==='day'){filtered=sessions.filter(s=>s.date.slice(0,10)===Fmt.todayKey());label="Today's Focus";goal=4*3600000;}
      else if(report==='week'){const ws=Fmt.weekStart();filtered=sessions.filter(s=>new Date(s.date)>=ws);label="This Week";goal=20*3600000;}
      else if(report==='month'){filtered=sessions.filter(s=>s.date.slice(0,7)===Fmt.monthKey());label="This Month";goal=80*3600000;}
      else{filtered=sessions;label="Lifetime";goal=500*3600000;}
      const total=filtered.reduce((a,s)=>a+s.ms,0);
      const count=filtered.length,avg=count?total/count:0,best=count?Math.max(...filtered.map(s=>s.ms)):0;
      const pct=Math.min(total/goal,1);
      const streak=getStreak(sessions);
      let insight='';
      if(!count)insight='No sessions yet. Start a timer, task, or Pomodoro.';
      else if(report==='day'){const h=(total/3600000).toFixed(1);insight=`Focused for <span>${h}h</span> today across <span>${count} session${count!==1?'s':''}</span>. ${total>=4*3600000?'Outstanding! 🔥':total>=2*3600000?'Great effort!':'Keep going!'}`;}
      else if(report==='week'){insight=`Averaging <span>${Fmt.durShort(total/7)}/day</span> this week across <span>${count} sessions</span>.`;}
      else if(report==='month'){const days=new Set(filtered.map(s=>s.date.slice(0,10))).size;insight=`Active on <span>${days} days</span> this month.`;}
      else{insight=`<span>${count} total sessions</span>. Best: <span>${Fmt.durShort(best)}</span>. Streak: <span>${streak}d</span>.`;}
      let extra=''; if(report==='month') extra=this.renderMiniCal(sessions);
      document.getElementById('report-body').innerHTML=`
        <div class="report-hero"><div class="report-hero-time">${Fmt.durShort(total)||'0m'}</div><div class="report-hero-label">${label}</div></div>
        <div class="report-stats-row">
          <div class="report-stat-box"><div class="report-stat-val">${count}</div><div class="report-stat-lbl">Sessions</div></div>
          <div class="report-stat-box"><div class="report-stat-val">${avg?Fmt.durShort(avg):'—'}</div><div class="report-stat-lbl">Avg</div></div>
          <div class="report-stat-box"><div class="report-stat-val">${best?Fmt.durShort(best):'—'}</div><div class="report-stat-lbl">Best</div></div>
        </div>
        <div class="report-bar-wrap">
